@model LMS.Domain.ViewModels.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="card p-4 p-md-5">
            <div class="mb-4">
                <h1 class="h2 fw-bold mb-2">Create new password</h1>
                <p class="text-muted mb-0" style="font-size:14px">Please enter your new password below.</p>
            </div>

            <form asp-action="ResetPassword" method="post" class="needs-validation" novalidate>
               
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

               
                <input type="hidden" asp-for="Token" />
                <input type="hidden" asp-for="Email" />

                <!-- New Password -->
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">New Password</label>
                    <input asp-for="Password" class="form-control" type="password" required />
                    <span asp-validation-for="Password" class="text-danger" style="font-size:13px"></span>
                </div>

                <!-- Confirm Password -->
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:13px"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Reset Password</button>
            </form>
        </div>
    </div>
</div>
