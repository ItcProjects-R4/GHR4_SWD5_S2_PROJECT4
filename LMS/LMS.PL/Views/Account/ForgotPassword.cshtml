@model LMS.Domain.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="card p-4 p-md-5">

            <div class="mb-4">
                <h1 class="h2 fw-bold mb-2">Reset your password</h1>
                <p class="text-muted mb-0" style="font-size:16px">Enter your email and we'll send you a reset link.</p>
            </div>

            <form asp-action="ForgotPassword" method="post" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" class="form-control" placeholder="name@example.com" required>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 mb-3">Send Reset Link</button>

                <p class="text-center mb-0" style="font-size:13px;color:var(--text-muted)">
                    Remember your password? <a asp-action="Login" class="fw-semibold">Log in</a>
                </p>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
