@{
    ViewData["Title"] = "Password Reset Confirmed";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="card p-4 p-md-5 text-center">
            <div style="width:52px;height:52px;border-radius:50%;background:var(--accent-light);display:flex;align-items:center;justify-content:center;margin:0 auto 1.25rem">
                <i class="bi bi-shield-check" style="color:var(--accent-color);font-size:1.4rem"></i>
            </div>
            <h2 class="h5 fw-bold mb-2">Password Reset Successful</h2>
            <p class="text-muted mb-4" style="font-size:14px">
                Your password has been reset successfully. You can now log in with your new password.
            </p>
            <a href="@Url.Action("Login", "Account")" class="btn btn-primary w-100">Go to Login</a>
        </div>
    </div>
</div>
