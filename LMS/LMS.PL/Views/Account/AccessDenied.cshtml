@{
    ViewData["Title"] = "Access Denied";
}

<div class="error-body">
    <div class="text-center animate-fade-in px-3">
        <div style="width:100px;height:100px;border-radius:50%;background:#fef2f2;display:flex;align-items:center;justify-content:center;margin:0 auto 2.5rem">
            <i class="bi bi-lock-fill" style="color:#991b1b;font-size:2.5rem"></i>
        </div>
        <h1 class="h1 fw-bold mb-3" style="color:var(--text-primary)">Access Denied</h1>
        <p class="text-muted mb-5 mx-auto" style="max-width:600px;font-size:16px">
            You don't have permission to view this page. Contact your administrator if you think this is a mistake.
        </p>
        <div class="d-flex gap-2 justify-content-center">
            <button onclick="history.back()" class="btn btn-light">Go Back</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go to Home</a>
        </div>
    </div>
</div>

