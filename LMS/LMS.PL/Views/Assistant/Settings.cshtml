@model LMS.PL.ViewModels.AssistantSettingsViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Settings - Assistant Dashboard";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius:12px;">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius:12px;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4 animate-fade-in">
    <h1 class="h3 fw-bold mb-0" style="color:var(--text-primary)">Settings</h1>
</div>

<div class="animate-fade-in">
    <div class="row g-4">
        <!-- Left: Avatar card -->
        <div class="col-lg-4">
            <div class="card p-4 text-center border-0 shadow-sm">
                <div class="position-relative d-inline-block mx-auto mb-3">
                    @{
                        var initials = (!string.IsNullOrEmpty(Model.FirstName) ? Model.FirstName.Substring(0, 1).ToUpper() : "A") +
                                       (!string.IsNullOrEmpty(Model.LastName) ? Model.LastName.Substring(0, 1).ToUpper() : "");
                    }
                    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" alt="Avatar" class="rounded-circle" style="width: 100px; height: 100px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="avatar-lg mx-auto d-flex align-items-center justify-content-center bg-primary text-white fw-bold fs-2 rounded-circle"
                             style="width: 100px; height: 100px;">
                            @initials
                        </div>
                    }
                </div>
                <h3 class="h5 fw-bold mb-1" style="color:var(--text-primary)">@Model.FirstName @Model.LastName</h3>
                <div>
                    <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3 mb-4">Assistant</span>
                </div>
                <hr class="my-2">
                
                <!-- Upload Avatar Form -->
                <form asp-controller="Assistant" asp-action="UpdateAvatar" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="file" name="avatarFile" accept="image/*" class="d-none" id="avatarInput" onchange="this.form.submit()">
                    <button type="button" class="btn btn-light btn-sm w-100" onclick="document.getElementById('avatarInput').click()">
                        <i class="bi bi-camera me-1"></i> Update Avatar
                    </button>
                </form>
            </div>
        </div>

        <!-- Right: Forms -->
        <div class="col-lg-8">
            <!-- Personal Info -->
            <div class="card p-4 mb-4 border-0 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="h6 fw-bold mb-0" style="color:var(--text-primary)">Personal Information</h4>
                    <button class="btn btn-light btn-sm" type="button" onclick="toggleEdit()">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </button>
                </div>

                <!-- View mode -->
                <div id="view-mode">
                    <div class="info-row">
                        <span class="info-label">First Name</span>
                        <span class="info-value">@Model.FirstName</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Last Name</span>
                        <span class="info-value">@Model.LastName</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Email</span>
                        <span class="info-value">@Model.Email</span>
                    </div>
                </div>

                <!-- Edit mode -->
                <form id="edit-mode" class="d-none" asp-controller="Assistant" asp-action="UpdateProfile" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label small fw-bold">First Name</label>
                            <input asp-for="FirstName" class="form-control" required>
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label small fw-bold">Last Name</label>
                            <input asp-for="LastName" class="form-control" required>
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Email" class="form-label small fw-bold">Email Address</label>
                            <input asp-for="Email" class="form-control" readonly>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary btn-sm px-4">Save Changes</button>
                        <button type="button" class="btn btn-light btn-sm" onclick="toggleEdit()">Cancel</button>
                    </div>
                </form>
            </div>

            <!-- Security -->
            <div class="card p-4 border-0 shadow-sm">
                <h4 class="h6 fw-bold mb-4" style="color:var(--text-primary)">Security</h4>
                <form asp-controller="Assistant" asp-action="UpdatePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="CurrentPassword" class="form-label small fw-bold">Current Password</label>
                            <input asp-for="CurrentPassword" class="form-control" placeholder="Enter current password" required>
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NewPassword" class="form-label small fw-bold">New Password</label>
                            <input asp-for="NewPassword" class="form-control" placeholder="Enter new password" required>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label small fw-bold">Confirm New Password</label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm new password" required>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary btn-sm px-4">Update Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleEdit() {
            var viewMode = document.getElementById('view-mode');
            var editMode = document.getElementById('edit-mode');
            
            viewMode.classList.toggle('d-none');
            editMode.classList.toggle('d-none');
        }
    </script>
}