@model LMS.Domain.ViewModels.Assistant.AssistantDashboardViewModel
@{
    Layout = "_DashboardLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4 animate-fade-in">
    <h1 class="h3 fw-bold mb-0" style="color:var(--text-primary)">Assistant Dashboard</h1>
</div>

<!-- Stats Row -->
<div class="row g-4 mb-5 animate-fade-in">
    <div class="col-sm-6 col-xl-4">
        <div class="stat-card">
            <div class="stat-icon bg-warning-light text-warning">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div>
                <p class="stat-label">Pending Submissions</p>
                <h3 class="stat-value">@Model.PendingSubmissionsCount</h3>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="stat-card">
            <div class="stat-icon bg-success-subtle text-success">
                <i class="bi bi-check-all"></i>
            </div>
            <div>
                <p class="stat-label">Graded Today</p>
                <h3 class="stat-value">@Model.GradedTodayCount</h3>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="stat-card">
            <div class="stat-icon bg-info-subtle text-info">
                <i class="bi bi-shield-check"></i>
            </div>
            <div>
                <p class="stat-label">Active Permissions</p>
                <h3 class="stat-value" style="font-size: 0.95rem; line-height: 1.2;">@(Model.ActivePermissions ?? "None")</h3>
            </div>
        </div>
    </div>
</div>

<!-- Recent Submissions List -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="h4 mb-0">Recent Submissions</h3>
    <a asp-controller="Assistant" asp-action="Submissions" class="btn btn-primary btn-sm px-3">Review All</a>
</div>

<div class="d-flex flex-column gap-3 animate-fade-in" style="animation-delay: 0.1s;">
    @if (Model.RecentSubmissions != null && Model.RecentSubmissions.Any())
    {
        @foreach (var sub in Model.RecentSubmissions)
        {
            <div class="card border-0 shadow-sm transition-base hover-shadow-md">
                <div class="card-body p-3">
                    <div class="row align-items-center g-3">
                        <div class="col-md-4">
                            <div class="d-flex align-items-center">
                                <div class="user-avatar-sm me-3" style="width: 40px; height: 40px;">
                                    @sub.StudentInitial
                                </div>
                                <div>
                                    <h6 class="mb-0 fw-bold">@sub.StudentName</h6>
                                    <div class="text-muted small">Submitted @sub.SubmittedAt.ToString("g")</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="fw-bold small">@sub.CourseTitle</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Module Submission</div>
                        </div>
                        <div class="col-md-3 text-md-end">
                            <div class="d-flex align-items-center justify-content-md-end gap-3">
                                @if (!sub.IsGraded)
                                {
                                    <span class="badge bg-warning-subtle text-warning rounded-pill px-3">Pending</span>
                                    <a asp-controller="Assistant" asp-action="Submissions" class="btn btn-primary btn-sm px-3">Grade Now</a>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success rounded-pill px-3">Graded (@sub.Grade/100)</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="card border-0 shadow-sm p-5 text-center text-muted">
            <i class="bi bi-file-earmark-check display-4 mb-3"></i>
            <h6>No recent submissions found.</h6>
        </div>
    }
</div>