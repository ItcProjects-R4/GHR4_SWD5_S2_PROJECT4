@model IEnumerable<LMS.Domain.ViewModels.Shared.SubmissionListItemViewModel>
@{
    Layout = "_DashboardLayout";
    var searchString = Context.Request.Query["searchString"];
    var statusFilter = Context.Request.Query["statusFilter"].ToString();
    if (string.IsNullOrEmpty(statusFilter))
    {
        statusFilter = "all";
    }
}

<!-- Success Toast Banner -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 shadow-sm mb-4 animate-fade-in" style="border-radius: 12px; background-color: #d1e7dd; color: #0f5132;">
        <div class="d-flex align-items-center gap-3">
            <div class="stat-icon bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center rounded-circle" style="width: 40px; height: 40px; flex-shrink: 0;">
                <i class="bi bi-check-lg" style="font-size: 1.25rem;"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-1">Success!</h6>
                <p class="small mb-0 text-success-emphasis">@TempData["SuccessMessage"]</p>
            </div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4 animate-fade-in">
    <h1 class="h3 fw-bold mb-0" style="color:var(--text-primary)">Student Submissions</h1>
</div>

<!-- Search and Sorting Panel -->
<form asp-controller="Assistant" asp-action="Submissions" method="get" class="card border-0 shadow-sm mb-4 animate-fade-in" style="animation-delay: 0.05s;">
    <div class="card-body p-3">
        <div class="row g-3 align-items-center justify-content-between">
            <div class="col-md-4 d-flex align-items-center">
                <h5 class="fw-bold mb-0 text-dark" style="font-size: 1.1rem;">
                    Submissions Queue <span class="badge bg-primary text-white rounded-pill ms-2" style="font-size: 0.72rem; padding: 0.35em 0.8em; font-weight: 700;">@Model?.Count()</span>
                </h5>
            </div>
            <div class="col-md-8">
                <div class="d-flex flex-wrap align-items-center justify-content-md-end gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-secondary small fw-bold text-nowrap" style="font-size: 0.8rem;"><i class="bi bi-funnel-fill me-1"></i>Filter By:</span>
                        <select name="statusFilter" onchange="this.form.submit()" class="form-select bg-light border-0 px-3 py-2 fw-semibold text-secondary" style="font-size: 0.85rem; min-width: 160px; height: 38px; cursor: pointer; border-radius: 20px; box-shadow: none;">
                            <option value="all" selected="@(statusFilter == "all")">All Submissions</option>
                            <option value="pending" selected="@(statusFilter == "pending")">Pending Review</option>
                            <option value="graded" selected="@(statusFilter == "graded")">Graded Only</option>
                        </select>
                    </div>
                    <div style="min-width: 250px;">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0" style="border-top-left-radius: 20px; border-bottom-left-radius: 20px; height: 38px;">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" name="searchString" value="@searchString" class="form-control bg-light border-0 text-secondary" placeholder="Search by student or course..." style="border-top-right-radius: 20px; border-bottom-right-radius: 20px; font-size: 0.85rem; height: 38px;">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<!-- Submissions Grid List -->
<div class="row g-3 animate-fade-in" style="animation-delay: 0.1s;" id="submissionsListContainer">
    @if (Model != null && Model.Any())
    {
        @foreach (var sub in Model)
        {
            <div class="col-12 submission-item">
                <div class="card border-0 shadow-sm transition-base hover-shadow-md">
                    <div class="card-body p-4">
                        <div class="row align-items-center g-3">
                            <div class="col-md-4">
                                <div class="d-flex align-items-center">
                                    <div class="user-avatar-sm me-3" style="width: 44px; height: 44px; background-color: var(--accent-color);">
                                        @sub.StudentInitial
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold student-name-text">@sub.StudentName</h6>
                                        <div class="text-muted small"><i class="bi bi-clock me-1"></i>Submitted @sub.SubmittedAt.ToString("g")</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-5">
                                <div class="fw-bold small course-name-text">@sub.CourseTitle</div>
                                <div class="text-muted" style="font-size: 0.78rem;">Module Submission</div>
                            </div>
                            <div class="col-md-3 text-md-end">
                                <div class="d-flex align-items-center justify-content-md-end gap-3">
                                    @if (!sub.IsGraded)
                                    {
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2 fw-semibold">Pending</span>
                                        <a asp-controller="Assistant" asp-action="GradeSubmission" asp-route-id="@sub.Id" class="btn btn-primary btn-sm px-4 py-2 rounded-3 fw-bold">Grade</a>
                                    }
                                    else
                                    {
                                        <div class="me-2 text-md-end">
                                            <div class="fw-bold text-success h5 mb-0">@sub.Grade/100</div>
                                            <span class="text-muted small" style="font-size: 10px;">Graded Score</span>
                                        </div>
                                        <button type="button" class="btn btn-outline-secondary btn-sm px-3 py-2 rounded-3 fw-semibold"
                                                data-bs-toggle="modal"
                                                data-bs-target="#feedbackDetailModal-@sub.Id">
                                            View Feedback
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 py-5 text-center text-muted">
            <i class="bi bi-search display-3 mb-3 d-block text-muted"></i>
            <h4>No submissions found</h4>
            <p class="small text-secondary">Try adjusting your filters or search keywords.</p>
        </div>
    }
</div>

@if (Model != null)
{
    @foreach (var sub in Model.Where(s => s.IsGraded))
    {
        <div class="modal fade" id="feedbackDetailModal-@sub.Id" tabindex="-1" aria-labelledby="feedbackDetailModalLabel-@sub.Id" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold" id="feedbackDetailModalLabel-@sub.Id">Grade & Feedback Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="d-flex align-items-center mb-4 border-bottom pb-3">
                            <div class="user-avatar-sm me-3 bg-secondary text-white" style="width: 44px; height: 44px; font-weight: 700; font-size: 1rem; display: flex; align-items: center; justify-content: center;">
                                @sub.StudentInitial
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0">@sub.StudentName</h6>
                                <p class="text-muted small mb-0">@sub.CourseTitle</p>
                            </div>
                        </div>
                        <div class="p-3 bg-light rounded-3 mb-4 text-center">
                            <div class="text-muted small mb-1">Final Score</div>
                            <div class="h2 fw-bold mb-0 text-success">@sub.Grade/100</div>
                        </div>
                        <h6 class="fw-bold small mb-2 text-dark">Instructor Comments:</h6>
                        <p class="text-secondary small mb-0" style="line-height: 1.6;">@sub.Feedback</p>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-primary px-4 fw-semibold rounded-3" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }
}