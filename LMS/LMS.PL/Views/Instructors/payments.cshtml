@model IEnumerable<LMS.Domain.Models.Payment>

@{
    ViewData["Title"] = "Financial Reports - Admin";
    
    // Calculate total earnings from completed payments
    var completedPayments = Model.Where(p => p.Status == LMS.Domain.Enums.PaymentStatus.Completed).ToList();
    var totalEarnings = completedPayments.Sum(p => p.Amount);
}

<div class="dashboard-container">
    <aside class="sidebar">
        <ul class="sidebar-menu">
            <li class="menu-item">
                <a href="dashboard.html" class="menu-link ">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
            </li>
            <li class="menu-item">
                <a href="users.html" class="menu-link">
                    <i class="bi bi-people"></i> Users
                </a>
            </li>
            <li class="menu-item">
                <a href="enrollments.html" class="menu-link">
                    <i class="bi bi-person-check"></i> Enrollments
                </a>
            </li>
            <li class="menu-item">
                <a href="#coursesSubmenu" data-bs-toggle="collapse" class="menu-link d-flex align-items-center w-100 ">
                    <i class="bi bi-book"></i> Courses <i class="bi bi-chevron-down ms-auto" style="font-size: 0.8rem;"></i>
                </a>
                <ul class="collapse list-unstyled " id="coursesSubmenu">
                    <li class="menu-item mt-1">
                        <a href="courses.html" class="menu-link py-2 " style="padding-left: 3rem; font-size: 0.9rem;">
                            <i class="bi bi-grid"></i> All Courses
                        </a>
                    </li>
                    <li class="menu-item">
                        <a href="create-course.html" class="menu-link py-2 " style="padding-left: 3rem; font-size: 0.9rem;">
                            <i class="bi bi-plus-circle"></i> Create New Course
                        </a>
                    </li>
                </ul>
            </li>
            <li class="menu-item">
                <a href="submissions.html" class="menu-link ">
                    <i class="bi bi-file-earmark-check"></i> Submissions
                </a>
            </li>
            <li class="menu-item">
                <a href="payments.html" class="menu-link active">
                    <i class="bi bi-credit-card"></i> Payments
                </a>
            </li>
            <li class="menu-item">
                <a href="settings.html" class="menu-link ">
                    <i class="bi bi-gear"></i> Settings
                </a>
            </li>
            <li class="menu-item mt-auto border-top pt-2">
                <a href="../login.html" class="menu-link text-danger">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </a>
            </li>
        </ul>
    </aside>

    <main class="main-content">
        <div class="d-flex justify-content-between align-items-center mb-4 animate-fade-in">
            <h1 class="h3 fw-bold mb-0" style="color:var(--text-primary)">Financial Reports</h1>
        </div>
        
        <div class="row g-4 mb-4 animate-fade-in">
            <div class="col-md-4">
                <div class="card p-4 border-0 shadow-sm text-center">
                    <h6 class="text-muted small fw-bold text-uppercase mb-2">Total Earnings</h6>
                    <h2 class="display-6 fw-bold text-primary mb-0">@totalEarnings.ToString("N2") EGP</h2>
                    <span class="text-success small mt-2"><i class="bi bi-check-circle"></i> @completedPayments.Count Successful Transactions</span>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm animate-fade-in">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4">Transaction ID</th>
                            <th>User</th>
                            <th>Item</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">No transactions found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var payment in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-primary">
                                        @(string.IsNullOrEmpty(payment.TransactionId) ? "PENDING" : $"#TR-{payment.TransactionId}")
                                    </td>
                                    
                                    <td>@(payment.Student?.Email ?? "Unknown User")</td>
                                    
                                    <td class="small">Course: @payment.Course.Title</td>
                                    <td class="fw-bold">@payment.Amount.ToString("N2") EGP</td>
                                    
                                    <td>
                                        @if (payment.Status == LMS.Domain.Enums.PaymentStatus.Completed)
                                        {
                                            <span class="badge bg-success-subtle text-success rounded-pill">Success</span>
                                        }
                                        else if (payment.Status == LMS.Domain.Enums.PaymentStatus.Pending)
                                        {
                                            <span class="badge bg-warning-subtle text-warning rounded-pill">Pending</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger rounded-pill">Failed</span>
                                        }
                                    </td>
                                    
                                    <td class="text-end pe-4 small text-muted">@payment.PaidAt.ToString("MMM dd, yyyy")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>