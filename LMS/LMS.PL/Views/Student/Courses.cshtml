@model List<EnrolledCoursesViewModel>
@{
    ViewData["Title"] = "My Courses";
    Layout = "_DashboardLayout";
}
<div class="main-content py-2">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 animate-fade-in">
        <h1 class="page-title mb-0">My Courses</h1>
        <div class="w-100" style="max-width: 400px;">
            <div class="input-group border rounded-3 overflow-hidden shadow-sm">
                <span class="input-group-text bg-white border-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" id="searchInput" class="form-control border-0 ps-0 shadow-none search-input" placeholder="Search my courses...">
            </div>
        </div>
    </div>

    <div class="mb-4 animate-fade-in">
        <ul class="nav nav-pills gap-2" id="enrollmentTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active rounded-pill px-4 filter-btn" data-status="">All Courses</button>
            </li>
            <li class="nav-item">
                <button class="nav-link rounded-pill px-4 filter-btn" data-status="Active">Active</button>
            </li>
            <li class="nav-item">
                <button class="nav-link rounded-pill px-4 filter-btn" data-status="Completed">Completed</button>
            </li>
        </ul>
    </div>

    <div id="courseGrid">
        <partial name="_CourseList" model="Model" />
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let searchTimer;

            function loadCourses() {
                const status = $('.filter-btn.active').data('status') || "";
                const search = $('#searchInput').val();

                $.ajax({
                    url: '@Url.Action("Courses", "Student")',
                    type: 'GET',
                    data: { status: status, search: search },
                    success: function (data) {
                        $('#courseGrid').html(data);
                    },
                    error: function () {
                        alert('Error loading courses.');
                    }
                });
            }

            $('.filter-btn').on('click', function () {
                $('.filter-btn').removeClass('active');
                $(this).addClass('active');
                loadCourses();
            });

            $('#searchInput').on('input', function () {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(loadCourses, 300);
            });
        });
    </script>
}