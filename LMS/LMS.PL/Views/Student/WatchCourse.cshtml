@model CourseDetailsPageViewModel
@{
    ViewData["Title"] = Model.Course.Title;
    Layout = "_DashboardLayout";
}

<div class="w-100">
    <div class="container py-4">
        <div class="d-flex align-items-center mb-4">
            <a asp-action="Courses" asp-controller="Student" class="btn btn-light rounded-circle me-3 d-flex align-items-center justify-content-center p-0 border" style="width: 32px; height: 32px; background: #fff; color: #475569; border-color: #cbd5e1;">
                <i class="bi bi-arrow-left"></i>
            </a>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0" style="font-size: 0.9rem; font-weight: 500;">
                    <li class="breadcrumb-item"><a asp-controller="Student" asp-action="Dashboard" class="text-secondary text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Student" asp-action="Courses" class="text-secondary text-decoration-none">Courses</a></li>
                    <li class="breadcrumb-item active text-dark" aria-current="page">@Model.Course.Title</li>
                </ol>
            </nav>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4" style="min-height: 600px;">
                    <div id="lessonContentContainer" class="position-relative">
                        @if (Model.IsEnrolled)
                        {
                            @if (Model.ActiveContent != null)
                            {
                                <partial name="_Content" model="Model.ActiveContent" />
                            }
                            else
                            {
                                <div class="text-center py-5 my-5" id="lessonPlaceholder">
                                    <div id="placeholderText">
                                        <i class="bi bi-mortarboard display-1 text-primary-gradient mb-3 d-block opacity-50"></i>
                                        <h4 class="fw-bold text-dark">Select content to start learning</h4>
                                        <p class="text-muted" style="max-width: 400px; margin: 0 auto;">Choose any content from the curriculum sidebar on the right to start learning.</p>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-5 my-5" id="lessonPlaceholder">
                                <div id="placeholderText">
                                    <i class="bi bi-lock-fill display-1 text-warning mb-3 d-block opacity-50"></i>
                                    <h4 class="fw-bold text-dark">Course is Preview-Only</h4>
                                    <p class="text-muted mb-4" style="max-width: 400px; margin: 0 auto;">You are not enrolled in this course yet. Enroll now to access content, submit assignments, and track your progress!</p>
                                    <a asp-controller="Checkout" asp-action="Checkout" asp-route-courseId="@Model.Course.CourseId" class="btn btn-warning rounded-pill px-5 py-2.5 fw-bold text-dark shadow-sm">
                                      <i class="bi bi-plus-circle-fill me-2"></i>Enroll Now
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                    <div class="card-header bg-white py-3 px-4 border-bottom">
                        <h5 class="fw-bold mb-3 text-dark">Course Contents</h5>
                        
                        @if (Model.IsEnrolled)
                        {
                            <div class="progress-panel-watch">
                                <div class="d-flex justify-content-between align-items-center mb-1.5" style="font-size: 0.85rem;">
                                    <span class="fw-semibold text-primary">@Model.ProgressPercent% Completed</span>
                                    <span class="text-secondary">@Model.CompletedContents/@Model.TotalContents contents</span>
                                </div>
                                <div class="progress" style="height: 6px; border-radius: 99px; background: #e2e8f0;">
                                    <div class="progress-bar bg-primary"
                                         role="progressbar"
                                         style="width: @(Model.ProgressPercent)%; border-radius: 99px; background-color: var(--accent-color) !important;"
                                         aria-valuenow="@Model.ProgressPercent" aria-valuemin="0" aria-valuemax="100">
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="p-3 rounded-3" style="background-color: #fffbeb; border: 1px dashed #fde68a;">
                                <h6 class="fw-bold text-warning-emphasis mb-1 small"><i class="bi bi-star-fill me-1"></i>Preview Mode</h6>
                                <p class="mb-0 text-secondary" style="font-size: 0.75rem;">Enroll to unlock all modules, files and assignments.</p>
                            </div>
                        }
                    </div>
                    
                    <div class="card-body p-0" style="max-height: 650px; overflow-y: auto;">
                        @if (!Model.Course.Modules.Any())
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-journal-x display-6 text-muted d-block mb-2"></i>
                                <h6 class="fw-semibold text-muted">No modules available yet</h6>
                            </div>
                        }
                        else
                        {
                            <div class="accordion accordion-flush curriculum-accordion" id="curriculumAccordion">
                                <!-- About this Course Accordion Item -->
                                <div class="accordion-item border-bottom">
                                    <h2 class="accordion-header" id="heading-about-course">
                                        <button class="accordion-button collapsed fw-bold px-4 py-3"
                                                type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#aboutCourseCollapse"
                                                aria-expanded="false"
                                                aria-controls="aboutCourseCollapse"
                                                style="font-size: 0.9rem; background-color: #fafbfc;">
                                            <div class="d-flex align-items-center gap-3 w-100 me-2">
                                                <div class="flex-grow-1 text-truncate">
                                                    <span class="d-block text-truncate text-dark"><i class="bi bi-info-circle-fill me-2 text-secondary"></i>About this Course</span>
                                                </div>
                                            </div>
                                        </button>
                                    </h2>
                                    <div id="aboutCourseCollapse"
                                         class="accordion-collapse collapse"
                                         aria-labelledby="heading-about-course"
                                         data-bs-parent="#curriculumAccordion">
                                        <div class="accordion-body p-4 bg-white text-secondary" style="font-size: 0.85rem; line-height: 1.7;">
                                            @Model.Course.Description
                                        </div>
                                    </div>
                                </div>

                                @foreach (var module in Model.Course.Modules)
                                {
                                    int totalLessonsInModule = module.Contents.Count;
                                    int fileCount = module.Contents.Count(c => !string.IsNullOrEmpty(c.ArticleUrl));
                                    int assignmentCount = module.Assignment != null ? 1 : 0;

                                    bool isModuleHasActiveContent = module.Contents.Any(c => c.Id == Model.ActiveContentId);
                                    string collapseId = $"module-{module.Id}";

                                    <div class="accordion-item border-bottom">
                                        <h2 class="accordion-header" id="heading-@module.Id">
                                            <button class="accordion-button fw-bold px-4 py-3"
                                                    type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#@collapseId"
                                                    aria-expanded="@(isModuleHasActiveContent ? "true" : "false")"
                                                    aria-controls="@collapseId"
                                                    style="font-size: 0.9rem; background-color: @(isModuleHasActiveContent ? "var(--accent-light)" : "#fafbfc");">
                                                <div class="d-flex align-items-center gap-3 w-100 me-2">
                                                    <div class="flex-grow-1 text-truncate">
                                                        <span class="d-block text-truncate text-dark">@module.Title</span>
                                                        <span class="text-muted d-block fw-normal" style="font-size: 0.75rem; margin-top: 3px;">
                                                            @totalLessonsInModule lecture@(totalLessonsInModule != 1 ? "s" : "") • @fileCount file@(fileCount != 1 ? "s" : "") • @assignmentCount assignment@(assignmentCount != 1 ? "s" : "")
                                                        </span>
                                                    </div>
                                                </div>
                                            </button>
                                        </h2>

                                        <div id="@collapseId"
                                             class="accordion-collapse collapse @(isModuleHasActiveContent ? "show" : "")"
                                             aria-labelledby="heading-@module.Id"
                                             data-bs-parent="#curriculumAccordion">
                                            <div class="accordion-body p-2 bg-white">
                                                @if (!module.Contents.Any() && module.Assignment == null)
                                                {
                                                    <div class="text-muted text-center py-3" style="font-size:0.8rem;">
                                                        <i class="bi bi-inbox me-2"></i>No content added yet.
                                                    </div>
                                                }
                                                else
                                                {
                                                    @foreach (var content in module.Contents)
                                                    {
                                                        if (Model.IsEnrolled)
                                                        {
                                                            bool isActive = content.Id == Model.ActiveContentId;

                                                            <a asp-action="ContentDetails"
                                                               asp-route-id="@content.Id"
                                                               class="content-item load-content-link text-decoration-none @(isActive ? "active" : "") @(content.IsCompleted ? "completed-item" : "")"
                                                               data-content-id="@content.Id"
                                                               title="@content.Title">
                                                                <div class="d-flex align-items-center gap-3 flex-grow-1 text-truncate">
                                                                    <div class="content-icon-wrap flex-shrink-0" id="icon-container-@content.Id">
                                                                        @if (content.IsCompleted)
                                                                        {
                                                                            <i class="bi bi-check-circle-fill text-success completion-icon" style="font-size: 1rem;"></i>
                                                                        }
                                                                        else
                                                                        {
                                                                            <i class="bi bi-play-btn-fill text-primary completion-icon" style="font-size: 1rem; color: var(--accent-color) !important;"></i>
                                                                        }
                                                                    </div>
                                                                    <span class="content-label text-truncate" style="font-size: 0.85rem; font-weight: 500;">@content.Title</span>
                                                                </div>
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <div class="content-item locked text-decoration-none" title="Enroll to unlock: @content.Title">
                                                                <div class="d-flex align-items-center gap-3 flex-grow-1 text-truncate">
                                                                    <div class="content-icon-wrap flex-shrink-0">
                                                                        <i class="bi bi-lock-fill text-muted" style="font-size:0.95rem;"></i>
                                                                    </div>
                                                                    <span class="content-label text-truncate" style="font-size: 0.85rem;">@content.Title</span>
                                                                </div>
                                                            </div>
                                                        }
                                                    }

                                                    @if (module.Assignment != null)
                                                    {
                                                        if (Model.IsEnrolled)
                                                        {
                                                            <a asp-action="AssignmentDetails" asp-route-id="@module.Assignment!.Id" data-assignment-id="@module.Assignment!.Id" class="load-assignment-link content-item text-decoration-none">
                                                                <div class="d-flex align-items-center gap-3 flex-grow-1 text-truncate">
                                                                    <div class="assignment-icon-wrap flex-shrink-0">
                                                                        <i class="bi bi-file-earmark-arrow-up text-warning" style="font-size: 1rem;"></i>
                                                                    </div>
                                                                    <span class="content-label text-truncate" style="font-size: 0.85rem; font-weight: 500;">@module.Assignment!.Title</span>
                                                                </div>
                                                                <span class="badge bg-warning-subtle text-warning-emphasis px-2 py-0.5" style="font-size: 0.65rem; border-radius: 4px;">Assign</span>
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <div class="content-item locked text-decoration-none" title="Enroll to unlock: @module.Assignment!.Title">
                                                                <div class="d-flex align-items-center gap-3 flex-grow-1 text-truncate">
                                                                    <div class="assignment-icon-wrap flex-shrink-0">
                                                                        <i class="bi bi-lock-fill text-muted" style="font-size:0.95rem;"></i>
                                                                    </div>
                                                                    <span class="content-label text-truncate" style="font-size: 0.85rem;">@module.Assignment!.Title</span>
                                                                </div>
                                                            </div>
                                                        }
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).on('click', '.load-content-link', function (e) {
            e.preventDefault();

            const $link = $(this);
            const url = $link.attr('href');

            $('.load-content-link').removeClass('active');
            $('.load-assignment-link').removeClass('active');
            $link.addClass('active');

            $('#lessonContentContainer').html(
                '<div class="text-center py-5 my-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>'
            );

            $.ajax({
                url: url,
                type: 'GET',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function (html) {
                    $('#lessonContentContainer').html(html);
                },
                error: function () {
                    $('#lessonContentContainer').html(
                        '<div class="text-center py-5 text-danger"><i class="bi bi-exclamation-triangle display-6 d-block mb-3"></i><p class="fw-semibold mb-0">Could not load this content. Please try again.</p></div>'
                    );
                }
            });
        });

        $(document).on('click', '.load-assignment-link', function (e) {
            e.preventDefault();

            const $link = $(this);
            const url = $link.attr('href');

            $('.load-content-link').removeClass('active');
            $('.load-assignment-link').removeClass('active');
            $link.addClass('active');

            $('#lessonContentContainer').html(
                '<div class="text-center py-5 my-5"><div class="spinner-border text-warning" role="status"><span class="visually-hidden">Loading...</span></div></div>'
            );

            $.ajax({
                url: url,
                type: 'GET',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function (html) {
                    $('#lessonContentContainer').html(html);
                },
                error: function () {
                    $('#lessonContentContainer').html(
                        '<div class="text-center py-5 text-danger"><i class="bi bi-exclamation-triangle display-6 d-block mb-3"></i><p class="fw-semibold mb-0">Could not load this assignment. Please try again.</p></div>'
                    );
                }
            });
        });

        $(document).on('click', '#nextLessonBtn', function (e) {
            e.preventDefault();
            const $current = $('.load-content-link.active, .load-assignment-link.active').first();
            if ($current.length) {
                const $allLinks = $('.load-content-link, .load-assignment-link');
                const currentIndex = $allLinks.index($current);
                if (currentIndex >= 0 && currentIndex < $allLinks.length - 1) {
                    const $next = $allLinks.eq(currentIndex + 1);
                    const $accordionCollapse = $next.closest('.accordion-collapse');
                    if ($accordionCollapse.length && !$accordionCollapse.hasClass('show')) {
                        $accordionCollapse.collapse('show');
                    }
                    $next[0].click();
                } else {
                    $(this).prop('disabled', true).text('End of Course');
                }
            }
        });

        $(document).on('click', '#prevLessonBtn', function (e) {
            e.preventDefault();
            const $current = $('.load-content-link.active, .load-assignment-link.active').first();
            if ($current.length) {
                const $allLinks = $('.load-content-link, .load-assignment-link');
                const currentIndex = $allLinks.index($current);
                if (currentIndex > 0) {
                    const $prev = $allLinks.eq(currentIndex - 1);
                    
                    const $accordionCollapse = $prev.closest('.accordion-collapse');
                    if ($accordionCollapse.length && !$accordionCollapse.hasClass('show')) {
                        $accordionCollapse.collapse('show');
                    }
                    
                    $prev[0].click();
                }
            }
        });
    </script>
}
