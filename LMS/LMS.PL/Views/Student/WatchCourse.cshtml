@model CourseDetailsPageViewModel
@{
    ViewData["Title"] = Model.Course.Title;
    Layout = "_DashboardLayout";
}

<div class="w-100">
<div class="container py-4">
    <div class="premium-hero mb-4">
    <div class="hero-glow"></div>
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0" style="--bs-breadcrumb-divider-color: rgba(255,255,255,0.4); font-size: 0.85rem;">
            <li class="breadcrumb-item">
                <a asp-action="Dashboard" asp-controller="Student" class="text-white-50 text-decoration-none">
                    <i class="bi bi-house-fill me-1"></i>Dashboard
                </a>
            </li>
            <li class="breadcrumb-item">
                <a asp-action="Courses" asp-controller="Student" class="text-white-50 text-decoration-none">My Courses</a>
            </li>
            <li class="breadcrumb-item text-white active" aria-current="page">@Model.Course.Title</li>
        </ol>
    </nav>

    <div class="row align-items-end g-4">
        <div class="col-lg-8">
            <h1 class="hero-title mb-3">@Model.Course.Title</h1>
            <p class="hero-desc text-white-50 mb-4" style="max-width:620px;">@Model.Course.Description</p>

            <div class="hero-stats d-flex flex-wrap gap-4">
                <div class="hero-stat">
                    <div class="hero-stat-value">@Model.TotalContents</div>
                    <div class="hero-stat-label">Total Contents</div>
                </div>
                @if(Model.IsEnrolled)
                {
                    <div class="hero-stat">
                        <div class="hero-stat-value text-success">@Model.CompletedContents</div>
                        <div class="hero-stat-label">Completed</div>
                    </div>
                }
                <div class="hero-stat">
                    <div class="hero-stat-value">@Model.TotalModules</div>
                    <div class="hero-stat-label">Modules</div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            @if (Model.IsEnrolled)
            {
                <div class="progress-panel">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-semibold" style="font-size:0.9rem;">Your Progress</span>
                        <span class="fw-bold fs-5 @(Model.ProgressPercent == 100 ? "text-success" : "text-white")">@Model.ProgressPercent%</span>
                    </div>
                    <div class="progress" style="height:10px; border-radius:99px; background:rgba(255,255,255,0.15);">
                        <div class="progress-bar @(Model.ProgressPercent == 100 ? "bg-success" : "")"
                             role="progressbar"
                             style="width:@Model.ProgressPercent%; border-radius:99px; background: @(Model.ProgressPercent < 100 ? "linear-gradient(90deg,#3b82f6,#60a5fa)" : "");"
                             aria-valuenow="@Model.ProgressPercent" aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>
                    @if (Model.ProgressPercent == 100)
                    {
                        <div class="mt-3 text-center">
                            <span class="badge bg-success px-3 py-2 rounded-pill fs-6">
                                <i class="bi bi-trophy-fill me-1"></i> Course Completed!
                            </span>
                        </div>
                    }
                    else
                    {
                        <p class="text-white-50 mt-2 mb-0" style="font-size:0.8rem;">
                            @Model.CompletedContents of @Model.TotalContents contents done
                        </p>
                    }
                </div>
            }
            else
            {
                <div class="progress-panel" style="background: rgba(245, 158, 11, 0.15); border-color: rgba(245, 158, 11, 0.35);">
                    <h5 class="fw-bold text-warning mb-2"><i class="bi bi-star-fill me-2"></i>Unlock Full Access</h5>
                    <p class="text-white-50 mb-3" style="font-size:0.85rem;">Get lifetime access to all course contents, assignments, resources, and track your progress.</p>
                    <form asp-action="Enroll" asp-controller="Student" method="post" class="m-0">
                        <input type="hidden" name="courseId" value="@Model.Course.CourseId" />
                        <button type="submit" class="btn btn-warning w-100 rounded-pill py-2.5 fw-bold text-dark d-flex align-items-center justify-content-center gap-2 shadow-sm" style="transition: all 0.2s;">
                            <i class="bi bi-plus-circle-fill"></i> Enroll Now
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

<div class="mt-1">
    <div class="row g-4">
        <div class="col-lg-4 col-md-5">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden curriculum-sidebar-card">
                <div class="card-header bg-white py-3 px-4 border-bottom d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <span class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-2 flex-shrink-0" style="width: 32px; height: 32px; font-size: 0.85rem;">
                            <i class="bi bi-play-fill"></i>
                        </span>
                        Course Curriculum
                    </h5>
                    <span class="badge bg-light text-secondary border px-3 py-1.5 rounded-pill fw-semibold" style="font-size: 0.75rem;">
                        @Model.TotalContents Contents
                    </span>
                </div>
                <div class="card-body p-0 scrollable-curriculum">
                    @if (!Model.Course.Modules.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-journal-x display-6 text-muted d-block mb-3"></i>
                            <h6 class="fw-semibold text-muted">No modules available yet</h6>
                        </div>
                    }
                    else
                    {
                        <div class="accordion accordion-flush curriculum-accordion" id="curriculumAccordion">
                            @foreach (var module in Model.Course.Modules)
                            {
                                int totalLessonsInModule = module.Contents.Count;
                                bool isModuleHasActiveContent = module.Contents.Any(c => c.Id == Model.ActiveContentId);
                                string collapseId = $"module-{module.Id}";

                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="heading-@module.Id">
                                        <button class="accordion-button fw-bold px-4 py-3"
                                                type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@collapseId"
                                                aria-expanded="@(isModuleHasActiveContent ? "true" : "false")"
                                                aria-controls="@collapseId">
                                            <div class="d-flex align-items-center gap-2.5 w-100 me-2">
                                                <div class="flex-grow-1 text-truncate">
                                                    <span class="d-block text-truncate">@module.Title</span>
                                                    <span class="text-muted d-block fw-normal" style="font-size:0.75rem; margin-top: 2px;">
                                                        @totalLessonsInModule Content@(totalLessonsInModule != 1 ? "s" : "")@(module.Assignment != null ? " · 1 Assignment" : "")
                                                    </span>
                                                </div>
                                            </div>
                                        </button>
                                    </h2>

                                    <div id="@collapseId"
                                         class="accordion-collapse collapse @(isModuleHasActiveContent ? "show" : "")"
                                         aria-labelledby="heading-@module.Id"
                                         data-bs-parent="#curriculumAccordion">
                                        <div class="accordion-body px-3 pb-3">
                                            @if (!module.Contents.Any())
                                            {
                                                <div class="text-muted text-center py-3" style="font-size:0.8rem;">
                                                    <i class="bi bi-inbox me-2"></i>No content added yet.
                                                </div>
                                            }
                                            else
                                            {
                                                @foreach (var content in module.Contents)
                                                {
                                                    if (Model.IsEnrolled)
                                                    {
                                                        bool isActive = content.Id == Model.ActiveContentId;
                                                        <a asp-action="ContentDetails"
                                                           asp-route-id="@content.Id"
                                                           class="content-item-link lesson-nav-item load-content-link @(isActive ? "active-lesson" : "") @(content.IsCompleted ? "completed-item" : "")"
                                                           data-content-id="@content.Id"
                                                           title="@content.Title">
                                                            <div class="content-icon-wrap" id="icon-container-@content.Id">
                                                                @if (content.IsCompleted)
                                                                {
                                                                    <i class="bi bi-check-circle-fill text-success completion-icon" style="font-size:1.1rem;"></i>
                                                                }
                                                                else
                                                                {
                                                                    <i class="bi bi-play-circle completion-icon" style="font-size:1.1rem; color:#3b82f6;"></i>
                                                                }
                                                            </div>
                                                            <span class="content-label flex-grow-1 text-truncate">@content.Title</span>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <div class="content-item-link text-muted opacity-75" style="cursor: not-allowed;" title="Enroll to unlock: @content.Title">
                                                            <div class="content-icon-wrap">
                                                                <i class="bi bi-lock-fill text-muted" style="font-size:1rem;"></i>
                                                            </div>
                                                            <span class="content-label flex-grow-1 text-truncate">@content.Title</span>
                                                        </div>
                                                    }
                                                }
                                            }

                                            @if (module.Assignment != null)
                                            {
                                                if (Model.IsEnrolled)
                                                {
                                                    <a asp-action="AssignmentDetails" asp-route-id="@module.Assignment.Id" data-assignment-id="@module.Assignment.Id" class="load-assignment-link text-decoration-none">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="assignment-icon-wrap">
                                                                <i class="bi bi-clipboard2-check-fill" style="color:#f59e0b; font-size:1rem;"></i>
                                                            </div>
                                                            <div class="flex-grow-1 text-truncate">
                                                                <div class="fw-semibold text-truncate text-dark" style="font-size:0.8rem;">@module.Assignment.Title</div>
                                                                <div class="text-muted" style="font-size:0.7rem;">
                                                                    Due: @module.Assignment.DueDate.ToString("MMM dd") · @module.Assignment.MaxScore pts
                                                                </div>
                                                            </div>
                                                            <div>
                                                                <span class="badge bg-warning text-dark px-2 py-0.5" style="font-size:0.6rem;">Assignment</span>
                                                            </div>
                                                        </div>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <div class="load-assignment-link text-decoration-none opacity-75" 
                                                         title="Enroll to unlock: @module.Assignment.Title">
                                                        <div class="d-flex align-items-center gap-2 text-muted">
                                                            <div class="assignment-icon-wrap">
                                                            <i class="bi bi-lock-fill text-muted" style="font-size:1rem;"></i>
                                                            </div>
                                                            <div class="flex-grow-1 text-truncate">
                                                                <div class="fw-semibold text-truncate small">@module.Assignment.Title</div>
                                                                <div>Locked</div>
                                                            </div>
                                                            <div>
                                                                <span class="badge bg-secondary text-white px-2 py-0.5" style="font-size:0.6rem;">Locked</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8 col-md-7">
            <div class="card border-0 shadow-sm rounded-4 content-viewer-card">
                <div id="lessonContentContainer" class="p-4 position-relative">
                    @if (Model.IsEnrolled)
                    {
                        @if (Model.ActiveContent != null)
                        {
                            <partial name="_Content" model="Model.ActiveContent" />
                        }
                        else
                        {
                            <div class="text-center py-5 my-5" id="lessonPlaceholder">
                                <div id="placeholderText">
                                    <i class="bi bi-mortarboard display-1 text-primary-gradient mb-3 d-block opacity-50"></i>
                                    <h4 class="fw-bold text-dark">Select content to start learning</h4>
                                    <p class="text-muted" style="max-width: 400px; margin: 0 auto;">Choose any content from the curriculum sidebar on the left to start learning.</p>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 my-5" id="lessonPlaceholder">
                            <div id="placeholderText">
                                <i class="bi bi-lock-fill display-1 text-warning mb-3 d-block opacity-50"></i>
                                <h4 class="fw-bold text-dark">Course is Preview-Only</h4>
                                <p class="text-muted mb-4" style="max-width: 400px; margin: 0 auto;">You are not enrolled in this course yet. Enroll now to access content, submit assignments, and track your progress!</p>
                                <form asp-action="Enroll" asp-controller="Student" method="post" class="d-inline-block m-0">
                                    <input type="hidden" name="courseId" value="@Model.Course.CourseId" />
                                    <button type="submit" class="btn btn-warning rounded-pill px-5 py-2.5 fw-bold text-dark shadow-sm">
                                        <i class="bi bi-plus-circle-fill me-2"></i>Enroll Now
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
</div>
</div>

@section Scripts {
    <script>
        $(document).on('click', '.load-content-link', function (e) {
            e.preventDefault();

            const $link = $(this);
            const url = $link.attr('href');

            $('.load-content-link').removeClass('active-lesson');
            $('.load-assignment-link').removeClass('active-assignment');
            $link.addClass('active-lesson');

            $('#lessonContentContainer').html(
                '<div class="text-center py-5 my-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>'
            );

            $.ajax({
                url: url,
                type: 'GET',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function (html) {
                    $('#lessonContentContainer').html(html);
                },
                error: function () {
                    $('#lessonContentContainer').html(
                        '<div class="text-center py-5 text-danger"><i class="bi bi-exclamation-triangle display-6 d-block mb-3"></i><p class="fw-semibold mb-0">Could not load this content. Please try again.</p></div>'
                    );
                }
            });
        });

        $(document).on('click', '.load-assignment-link', function (e) {
            e.preventDefault();

            const $link = $(this);
            const url = $link.attr('href');

            $('.load-content-link').removeClass('active-lesson');
            $('.load-assignment-link').removeClass('active-assignment');
            $link.addClass('active-assignment');

            $('#lessonContentContainer').html(
                '<div class="text-center py-5 my-5"><div class="spinner-border text-warning" role="status"><span class="visually-hidden">Loading...</span></div></div>'
            );

            $.ajax({
                url: url,
                type: 'GET',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function (html) {
                    $('#lessonContentContainer').html(html);
                },
                error: function () {
                    $('#lessonContentContainer').html(
                        '<div class="text-center py-5 text-danger"><i class="bi bi-exclamation-triangle display-6 d-block mb-3"></i><p class="fw-semibold mb-0">Could not load this assignment. Please try again.</p></div>'
                    );
                }
            });
        });

        $(document).on('click', '#nextLessonBtn', function (e) {
            e.preventDefault();
            const $current = $('.active-lesson, .active-assignment').first();
            if ($current.length) {
                const $allLinks = $('.load-content-link, .load-assignment-link');
                const currentIndex = $allLinks.index($current);
                if (currentIndex >= 0 && currentIndex < $allLinks.length - 1) {
                    const $next = $allLinks.eq(currentIndex + 1);
                    
                    const $accordionCollapse = $next.closest('.accordion-collapse');
                    if ($accordionCollapse.length && !$accordionCollapse.hasClass('show')) {
                        $accordionCollapse.collapse('show');
                    }
                    
                    $next[0].click();
                } else {
                    
                    $(this).prop('disabled', true).text('End of Course');
                }
            }
        });
    </script>
}