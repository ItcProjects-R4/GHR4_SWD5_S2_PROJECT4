@model List<BrowseCourseViewModel>

@{
    ViewData["Title"] = "Browse Courses";
    Layout = "_DashboardLayout";
}
<div class="main-content py-2">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 animate-fade-in">
        <h1 class="page-title mb-0">Browse Courses</h1>
        <div class="w-100" style="max-width: 400px;">
            <div class="input-group border rounded-3 overflow-hidden shadow-sm">
                <span class="input-group-text bg-white border-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" id="searchInput" class="form-control border-0 ps-0 shadow-none search-input" placeholder="Search courses...">
            </div>
        </div>
    </div>

    <div id="courseGrid" class="animate-fade-in">
        <partial name="_BrowseCourseList" model="Model" />
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let searchTimer;

            function loadCourses() {
                const search = $('#searchInput').val();

                $.ajax({
                    url: '@Url.Action("BrowseCourses", "Student")',
                    type: 'GET',
                    data: { search: search },
                    success: function (data) {
                        $('#courseGrid').html(data);
                    },
                    error: function () {
                        console.error('Error loading courses.');
                    }
                });
            }

            $('#searchInput').on('input', function () {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(loadCourses, 300);
            });

            $(document).on('click', '#clearSearchBtn', function () {
                $('#searchInput').val('');
                loadCourses();
            });
        });
    </script>
}
