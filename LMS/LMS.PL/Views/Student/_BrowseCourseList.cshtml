@model List<BrowseCourseViewModel>

@if (Model == null || !Model.Any())
{
    <div class="py-5 text-center">
        <i class="bi bi-search display-4 mb-3 d-block text-muted"></i>
        <h5 class="fw-bold text-dark">No courses found</h5>
        <p class="text-muted">No courses available matching your query.</p>
        <button id="clearSearchBtn" class="btn btn-outline-primary btn-sm mt-2 px-3 rounded-pill">View All Courses</button>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var course in Model)
        {
            <div class="col-sm-6 col-md-6 col-xl-4">

                <div class="card course-card border-0 shadow-sm position-relative" style="transition: transform 0.3s ease, box-shadow 0.3s ease;">

                    <!-- Floating "Enrolled" badge for purchased courses -->
                    @if (course.IsEnrolled)
                    {
                        <span class="badge bg-success position-absolute m-3 top-0 end-0 shadow-sm" style="z-index: 5; font-size: 0.75rem; padding: 0.4em 0.8em; border-radius: 6px;">
                            <i class="bi bi-check-circle-fill me-1.5"></i>Enrolled
                        </span>
                    }

                    <img src="@course.ThumbnailUrl"
                         class="course-card-img"
                         alt="@course.CourseTitle"
                         onerror="this.style.background='#1a1a2e';this.removeAttribute('src')" />

                    <div class="course-card-body d-flex flex-column justify-content-between" style="min-height: 140px;">
                        <h4 class="course-title mb-2" style="font-size: 1.1rem;">@course.CourseTitle</h4>

                        <div class="d-flex justify-content-between align-items-center mt-auto">
                            <span class="fw-bold fs-5 text-primary">@course.Price.ToString("N2") EGP</span>

                            <!-- 💡 Redirects both enrolled and non-enrolled students directly to the WatchCourse preview/learning page -->
                            <a asp-action="WatchCourse" asp-controller="Student" asp-route-id="@course.CourseId" class="btn btn-outline-primary btn-sm">
                                View Course
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
