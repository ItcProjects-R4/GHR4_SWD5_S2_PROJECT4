@model List<EnrolledCoursesViewModel>

@if (Model == null || !Model.Any())
{
    <div class="text-center py-5 px-3 bg-white border rounded-4 shadow-sm w-100 animate-fade-in">
        <i class="bi bi-journal-x display-1 text-muted mb-3 d-block"></i>
        <h3 class="fw-semibold">No courses found</h3>
        <p class="text-muted">You haven't enrolled in any courses yet.</p>
        <a asp-action="BrowseCourses" class="btn btn-primary rounded-pill px-4">Browse Courses</a>
    </div>
}
else
{
    <div class="row g-4 animate-fade-in">
        @foreach (var course in Model)
        {
            <div class="col-sm-6 col-md-6 col-xl-4">
                <div class="course-card">

                    <img src="@course.ThumbnailUrl"
                         class="course-card-img"
                         alt="@course.CourseTitle"
                         onerror="this.style.background='#1a1a2e';this.removeAttribute('src')" />

                    <div class="course-card-body">

                        <div class="d-flex align-items-start justify-content-between gap-2 mb-1">
                            <h4 class="course-title">@course.CourseTitle</h4>
                            @if (course.EnrollmentStatus == "Completed")
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1.5 fw-medium rounded-pill">Completed</span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 fw-medium rounded-pill">Active</span>
                            }
                        </div>

                        <div class="progress mb-2" style="height: 6px;">
                            @{
                                var progressColor = course.ProgressPercentage switch
                                {
                                    100 => "bg-success",
                                    >= 75 => "bg-info",
                                    >= 50 => "bg-warning",
                                    >= 25 => "bg-primary",
                                    _ => "bg-danger"
                                };
                            }
                            <div class="progress-bar @progressColor"
                                 role="progressbar"
                                 style="width: @course.ProgressPercentage%"
                                 aria-valuenow="@course.ProgressPercentage"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                            </div>
                        </div>

                        <div class="course-meta">
                            <span>@course.ProgressPercentage% Complete</span>
                            <span>@course.CompletedLessonsCount/@course.TotalLessonsCount Contents</span>
                        </div>

                        @if (course.EnrollmentStatus == "Completed")
                        {
                            <a asp-action="WatchCourse"
                               asp-route-id="@course.CourseId"
                               class="btn btn-outline-success w-100 py-2 d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-check-circle-fill"></i> Completed
                            </a>
                        }
                        else
                        {
                            <a asp-action="WatchCourse"
                               asp-route-id="@course.CourseId"
                               class="btn btn-outline-primary w-100 py-2">
                                Continue Learning
                            </a>
                        }

                    </div>
                </div>
            </div>
        }
    </div>
}