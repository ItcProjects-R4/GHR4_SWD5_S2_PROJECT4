<aside class="sidebar">
    <ul class="sidebar-menu">
        <li class="menu-item">
            <a asp-controller="Instructor" asp-action="Dashboard" class="menu-link @(IsActive("Instructor", "Dashboard"))">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
        </li>
        <li class="menu-item">
            <a asp-controller="Instructor" asp-action="Users" class="menu-link @(IsActive("Instructor", "Users"))">
                <i class="bi bi-people"></i> Users
            </a>
        </li>
        <li class="menu-item">
            <a asp-controller="Instructor" asp-action="Enrollments" class="menu-link @(IsActive("Instructor", "Enrollments"))">
                <i class="bi bi-person-check"></i> Enrollments
            </a>
        </li>
        <!-- Courses Dropdown Menu -->
        <li class="menu-item">
            <a href="#coursesSubmenu" data-bs-toggle="collapse"
               class="menu-link d-flex align-items-center w-100 @(IsActive("Instructor", "Courses") != "" || IsActive("Instructor", "CreateCourse") != "" ? "" : "collapsed")"
               aria-expanded="@(IsActive("Instructor", "Courses") != "" || IsActive("Instructor", "CreateCourse") != "" ? "true" : "false")">
                <i class="bi bi-book"></i> Courses
                <i class="bi bi-chevron-down ms-auto" style="font-size: 0.8rem;"></i>
            </a>
            <ul class="collapse list-unstyled @(IsActive("Instructor", "Courses") != "" || IsActive("Instructor", "CreateCourse") != "" ? "show" : "")" id="coursesSubmenu">
                <li class="menu-item mt-1">
                    <a asp-controller="Instructor" asp-action="Courses"
                       class="menu-link py-2 @(IsActive("Instructor", "Courses"))"
                       style="padding-left: 3rem; font-size: 0.9rem;">
                        <i class="bi bi-grid"></i> All Courses
                    </a>
                </li>
                <li class="menu-item">
                    <a asp-controller="Instructor" asp-action="CreateCourse"
                       class="menu-link py-2 @(IsActive("Instructor", "CreateCourse"))"
                       style="padding-left: 3rem; font-size: 0.9rem;">
                        <i class="bi bi-plus-circle"></i> Create New Course
                    </a>
                </li>
            </ul>
        </li>
        <li class="menu-item">
            <a asp-controller="Instructor" asp-action="Submissions" class="menu-link @(IsActive("Instructor", "Submissions"))">
                <i class="bi bi-file-earmark-check"></i> Submissions
            </a>
        </li>
        <li class="menu-item">
            <a asp-controller="Instructor" asp-action="Payments" class="menu-link @(IsActive("Instructor", "Payments"))">
                <i class="bi bi-credit-card"></i> Payments
            </a>
        </li>
        <li class="menu-item">
            <a asp-controller="Instructor" asp-action="Settings" class="menu-link @(IsActive("Instructor", "Settings"))">
                <i class="bi bi-gear"></i> Settings
            </a>
        </li>
        <li class="menu-item mt-auto border-top pt-2">
            <form asp-controller="Account" asp-action="Logout" method="post" id="sidebarLogoutForm" class="d-none">
                @Html.AntiForgeryToken()
            </form>
            <a href="javascript:document.getElementById('sidebarLogoutForm').submit();" class="menu-link text-danger">
                <i class="bi bi-box-arrow-right"></i> Logout
            </a>
        </li>
    </ul>
</aside>

@functions {
    private string IsActive(string controller, string action)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

        return string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
               string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)
               ? "active" : "";
    }
}