<aside class="sidebar">
    <div class="sidebar-content">
        <div class="sidebar-header">
            <span class="sidebar-title">Workspace</span>
            <button class="btn-sidebar-toggle" id="sidebarCloseToggle" title="Collapse Sidebar">
                <i class="bi bi-layout-sidebar"></i>
            </button>
        </div>
        <ul class="sidebar-menu">
            <li class="menu-item">
                <a asp-controller="Assistant" asp-action="Dashboard" class="menu-link @(IsActive("Assistant", "Dashboard"))">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
            </li>
            <li class="menu-item">
                <a asp-controller="Assistant" asp-action="Submissions" class="menu-link @(IsActive("Assistant", "Submissions"))">
                    <i class="bi bi-file-earmark-check"></i> Submissions
                </a>
            </li>
            <li class="menu-item">
                <a asp-controller="Assistant" asp-action="Settings" class="menu-link @(IsActive("Assistant", "Settings"))">
                    <i class="bi bi-gear"></i> Settings
                </a>
            </li>
        </ul>
    </div>
</aside>

@functions {
    private string IsActive(string controller, string action)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

        return string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
               string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)
               ? "active" : "";
    }
}
