@using LMS.PL.Helpers
@using Microsoft.AspNetCore.Html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LMS </title>
    <script type="importmap"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <link rel="stylesheet" href="~/css/index.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <!-- Global Dashboard Navbar -->
        <nav class="navbar navbar-expand-lg navbar-public sticky-top" style="z-index: 1040;">
            <div class="container-fluid px-4">
                <div class="d-flex align-items-center">
                    <button class="btn btn-light d-lg-none me-3" id="sidebar-toggle">
                        <i class="bi bi-list"></i>
                    </button>
                    <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-mortarboard-fill" style="color: var(--accent-color); font-size: 1.2rem;"></i>
                        <span style="font-weight:700; font-size:1rem; color:var(--text-primary); letter-spacing:-0.01em;">LMS Platform</span>
                    </a>
                </div>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    @if (User.IsInRole("Student"))
                    {
                        <ul class="navbar-nav me-auto ms-lg-5 gap-lg-1">
                            <li class="nav-item">
                                <a asp-controller="Home" asp-action="Index" class="nav-link">Home</a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Home" asp-action="About" class="nav-link">About</a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Home" asp-action="Contact" class="nav-link">Contact</a>
                            </li>
                        </ul>
                    }
                    <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0 ms-auto">
                        <div class="dropdown">
                            <button id="notificationDropdownBtn" class="btn btn-light position-relative d-flex align-items-center justify-content-center p-0 rounded-circle" style="width: 32px; height: 32px;" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-bell"></i>
                                <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display: none; font-size: 0.65rem;">
                                    0
                                </span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-0" id="notificationList" style="width: 280px; max-height: 400px; overflow-y: auto;">
                                <li class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light sticky-top">
                                    <span class="fw-bold" style="font-size: 14px;">Notifications</span>
                                </li>
                                @await Component.InvokeAsync("Notification")
                            </ul>
                        </div>

                        <!-- User Avatar & Profile Dropdown -->
                        <div class="dropdown">
                            <button class="btn d-flex align-items-center gap-2 p-1 pe-3 border-0 bg-transparent" type="button" data-bs-toggle="dropdown">
                                @if (!string.IsNullOrEmpty(User.GetAvatarUrl()))
                                {
                                    <img src="@User.GetAvatarUrl()" alt="Avatar" class="rounded-circle" style="width: 32px; height: 32px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="user-avatar-sm" style="width: 32px; height: 32px; font-weight: 600; font-size: 0.8rem; background-color: var(--accent-color); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                        @User.GetFirstName().Substring(0, Math.Min(2, User.GetFirstName().Length)).ToUpper()
                                    </div>
                                }
                                <div class="text-start d-none d-md-block">
                                    <div class="fw-bold small" style="line-height: 1; color: var(--text-primary);">
                                        @User.GetFirstName() @User.GetLastName()
                                    </div>
                                </div>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                <li>
                                    @if (User.IsInRole("Instructor"))
                                    {
                                        <a class="dropdown-item py-2" asp-controller="Instructor" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a>
                                    }
                                    else if (User.IsInRole("Assistant"))
                                    {
                                        <a class="dropdown-item py-2" asp-controller="Assistant" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a>
                                    }
                                    else if (User.IsInRole("Student"))
                                    {
                                        <a class="dropdown-item py-2" asp-controller="Student" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a>
                                    }
                                </li>
                                <li>
                                    @if (User.IsInRole("Instructor"))
                                    {
                                        <a class="dropdown-item py-2" asp-controller="Instructor" asp-action="Settings"><i class="bi bi-gear me-2"></i> Settings</a>
                                    }
                                    else if (User.IsInRole("Assistant"))
                                    {
                                        <a class="dropdown-item py-2" asp-controller="Assistant" asp-action="Settings"><i class="bi bi-gear me-2"></i> Settings</a>
                                    }
                                    else if (User.IsInRole("Student"))
                                    {
                                        <a class="dropdown-item py-2" asp-controller="Student" asp-action="Settings"><i class="bi bi-gear me-2"></i> Settings</a>
                                    }
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item py-2 text-danger border-0 bg-transparent text-start w-100">
                                            <i class="bi bi-box-arrow-right me-2"></i> Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="dashboard-container student-workspace-container workspace-container">
        @if (User.Identity.IsAuthenticated)
        {
            if (User.IsInRole("Instructor"))
            {
                <partial name="~/Views/Shared/Sidebars/_InstructorSidebar.cshtml" />
            }
            else if (User.IsInRole("Student"))
            {
                <partial name="~/Views/Shared/Sidebars/_StudentSidebar.cshtml" />
            }
            else if (User.IsInRole("Assistant"))
            {
                <partial name="~/Views/Shared/Sidebars/_AssistantSidebar.cshtml" />
            }
        }
        <main class="main-content d-flex flex-column">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/assets/js/main.js" asp-append-version="true"></script>
    <script src="~/js/dashboard-toggle.js" asp-append-version="true"></script>
    @if (User.Identity.IsAuthenticated)
    {
        <script src="~/js/notification.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
