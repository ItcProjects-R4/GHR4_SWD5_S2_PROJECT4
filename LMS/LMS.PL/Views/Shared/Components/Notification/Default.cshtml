@using LMS.BLL.ViewModels
@using LMS.Domain.Enums
@model IEnumerable<NotificationDto>

@{
    var unreadCount = Model.Count(n => !n.IsRead);
}

<!-- Notification Badge Data attribute for JS to read -->
<span id="initialUnreadCount" style="display:none;" data-count="@unreadCount"></span>

@if (Model != null && Model.Any())
{
    foreach (var notification in Model)
    {
        var iconClass = "bi-info-circle text-primary";
        if (notification.Type == NotificationType.CoursePurchase) iconClass = "bi-bag-check text-success";
        if (notification.Type == NotificationType.SystemAlert) iconClass = "bi-exclamation-triangle text-warning";
        if (notification.Type == NotificationType.AssignmentUpdate) iconClass = "bi-journal-check text-info";

        var bgStyle = notification.IsRead ? "" : "background-color: #f8f9fa;";

        <li class="p-3 border-bottom @(notification.IsRead ? "" : "unread-notification")" style="@bgStyle">
            <div class="d-flex align-items-start gap-2">
                <i class="bi @iconClass mt-1"></i>
                <div>
                    <h6 class="mb-1" style="font-size: 13px; font-weight: 600;">@notification.Title</h6>
                    <p class="mb-1 text-muted" style="font-size: 12px; line-height: 1.4;">@notification.Message</p>
                    <small class="text-secondary" style="font-size: 11px;">@notification.CreatedAt.ToString("g")</small>
                </div>
            </div>
        </li>
    }
}
else
{
    <li class="p-4 text-center text-secondary-50" id="noNotificationsMsg">
        <i class="bi bi-bell-slash d-block fs-3 mb-2 text-muted"></i>
        <span class="small fw-medium text-muted">No new notifications</span>
    </li>
}
