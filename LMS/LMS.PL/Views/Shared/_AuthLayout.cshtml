<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LMS </title>
    <script type="importmap"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <link rel="stylesheet" href="~/css/index.css" />

    <link rel="stylesheet" href="~/LMS.PL.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <!-- Navbar -->
        <nav class="navbar navbar-expand-lg navbar-public sticky-top">
            <div class="container-fluid px-4">
                <a asp-controller="Home" asp-action="Index" class="navbar-brand d-flex align-items-center gap-2">
                    <i class="bi bi-mortarboard-fill" style="color: var(--accent-color); font-size: 1.3rem;"></i>
                    <span style="font-weight:700; font-size:1.05rem; color:var(--text-primary); letter-spacing:-0.01em;">Lmsify</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto ms-lg-5 gap-lg-1">

                        @* Home *@
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index" class="nav-link active">Home</a>
                        </li>

                        @* Browse Courses *@
                        <li class="nav-item">
                            <a asp-controller="Courses" asp-action="Index" class="nav-link">Browse Courses</a>
                        </li>

                        @* About *@
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="About" class="nav-link">About</a>
                        </li>

                        @* Contact *@
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Contact" class="nav-link">Contact</a>
                        </li>

                    </ul>
                    <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-light">Sign in</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Create account</a>
                    </div>
                </div>
            </div>
        </nav>

    </header>
    <div class="auth-wrap">
        <main role="main">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

