@{
    Layout = "_EmptyLayout";
}
<div class="d-flex align-items-center justify-content-center" style="min-height: 100vh; background-color: #f8f9fa;">
    <div class="text-center animate-fade-in">
        <i class="bi bi-mortarboard-fill mb-4 d-block" style="color:var(--accent-color);font-size:2.5rem"></i>
        <div class="spinner mx-auto mb-3"></div>
        <p class="text-muted" style="font-size:14px">Preparing your experience…</p>
    </div>

    <script>
            setTimeout(() => {
                window.location.href = '@Url.Action("Index", "Home")';
            }, 2000);
    </script>
</div>