@using LMS.PL.Helpers
@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LMS </title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    
    <link rel="stylesheet" href="~/css/index.css" />
   
    <link rel="stylesheet" href="~/LMS.PL.styles.css" asp-append-version="true" />



    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <!-- Navbar -->
        <nav class="navbar navbar-expand-lg navbar-public sticky-top">
            <div class="container-fluid px-4">
                <a asp-controller="Home" asp-action="Index" class="navbar-brand d-flex align-items-center gap-2">
                    <i class="bi bi-mortarboard-fill" style="color: var(--accent-color); font-size: 1.3rem;"></i>
                    <span style="font-weight:700; font-size:1.05rem; color:var(--text-primary); letter-spacing:-0.01em;">LMS Platform</span>
                </a>

                <button class="navbar-toggler border-0" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">

                    <ul class="navbar-nav me-auto ms-lg-5 gap-lg-1">
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index" class="nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")">Home</a>
                            </li>
                        <li class="nav-item">
                            <a asp-controller="Course" asp-action="Browse" class="nav-link @(currentController == "Course" && currentAction == "Browse" ? "active" : "")">Browse Courses</a>
                            </li>
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="About" class="nav-link @(currentController == "Home" && currentAction == "About" ? "active" : "")">About</a>
                            </li>
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Contact" class="nav-link @(currentController == "Home" && currentAction == "Contact" ? "active" : "")">Contact</a>
                            </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0 ms-auto">
                        @if (User.Identity.IsAuthenticated)
                        {
                            if (User.IsInRole("Student"))
                            {
                                <!-- only Students get the Avatar Dropdown on public pages -->
                                <div class="dropdown">
                                    <button class="btn d-flex align-items-center gap-2 p-1 pe-3 border-0 bg-transparent" type="button" data-bs-toggle="dropdown">
                                        @if (!string.IsNullOrEmpty(User.GetAvatarUrl()))
                                        {
                                            <img src="@User.GetAvatarUrl()" alt="Avatar" class="rounded-circle" style="width: 32px; height: 32px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="user-avatar-sm" style="width: 32px; height: 32px; font-weight: 600; font-size: 0.8rem; background-color: var(--accent-color); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                                @User.GetFirstName().Substring(0, Math.Min(2, User.GetFirstName().Length)).ToUpper()
                                            </div>
                                        }
                                        <div class="text-start d-none d-md-block">
                                            <div class="fw-bold small" style="line-height: 1; color: var(--text-primary);">
                                                @User.GetFirstName() @User.GetLastName()
                                            </div>
                                        </div>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Student" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Student" asp-action="Settings"><i class="bi bi-gear me-2"></i> Settings</a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item py-2 text-danger border-0 bg-transparent text-start w-100">
                                                    <i class="bi bi-box-arrow-right me-2"></i> Logout
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <!-- instructors and assistants see the standard Dashboard and Sign out buttons directly -->
                                if (User.IsInRole("Instructor"))
                                {
                                    <a asp-controller="Instructor" asp-action="Dashboard" class="btn btn-primary">Dashboard</a>
                                }
                                else if (User.IsInRole("Assistant"))
                                {
                                    <a asp-controller="Assistant" asp-action="Dashboard" class="btn btn-primary">Dashboard</a>
                                }

                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-light ms-2">Sign out</button>
                                </form>
                            }
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-light">Sign in</a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Create account</a>
                        }
                    </div>



                </div>

            </div>
        </nav>
       
    </header>
    <div class="container-fluid p-0">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="site-footer bg-white border-top py-5 mt-auto">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-6">
                    <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center gap-2 mb-3 text-decoration-none">
                        <i class="bi bi-mortarboard-fill" style="color:var(--accent-color);font-size:1.2rem"></i>
                        <span style="font-weight:700;color:var(--text-primary);font-size:1rem">LMS Platform</span>
                    </a>
                    <p style="font-size:14px;color:var(--text-muted);max-width:280px;line-height:1.6;margin-bottom:1rem;">Empowering learners worldwide with accessible, high-quality education.</p>
                    <div class="d-flex gap-3">
                        <a href="#" class="text-muted text-decoration-none fs-5"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-muted text-decoration-none fs-5"><i class="bi bi-linkedin"></i></a>
                        <a href="#" class="text-muted text-decoration-none fs-5"><i class="bi bi-youtube"></i></a>
                        <a href="#" class="text-muted text-decoration-none fs-5"><i class="bi bi-github"></i></a>
                    </div>
                </div>
                <div class="col-lg-4 ms-lg-auto">
                    <div class="footer-heading fw-bold mb-3" style="color:var(--text-primary);">Stay Updated</div>
                   
                    <form asp-controller="Home" asp-action="Subscribe" method="post">
                        <div class="input-group">
                            <input type="email" name="email" class="form-control" placeholder="Your email" required>
                            <button class="btn btn-primary" type="submit">Join</button>
                        </div>
                    </form>

                </div>
            </div>
            <div class="pt-3" style="border-top: 1px solid var(--border-color);">
                <p class="mb-0 text-center" style="font-size:13px;color:var(--text-muted)">&copy; 2026 LMS Platform. All rights reserved.</p>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
