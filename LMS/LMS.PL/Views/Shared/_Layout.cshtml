<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LMS </title>
    <script type="importmap"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    
    <link rel="stylesheet" href="~/css/index.css" />
   
    <link rel="stylesheet" href="~/LMS.PL.styles.css" asp-append-version="true" />

</head>
<body>
    <header>
        <!-- Navbar -->
        <nav class="navbar navbar-expand-lg navbar-public sticky-top">
            <div class="container-fluid px-4">

                <a class="navbar-brand d-flex align-items-center gap-2"
                   asp-controller="Home" asp-action="Index">

                    <i class="bi bi-mortarboard-fill"
                       style="color: var(--accent-color); font-size: 1.3rem;"></i>

                    <span style="font-weight:700; font-size:1.05rem;">
                        LMS Platform
                    </span>

                </a>

                <button class="navbar-toggler border-0" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">

                    <ul class="navbar-nav me-auto ms-lg-5 gap-lg-1">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Course" asp-action="Index">Browse Courses</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About">About</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>

                    </ul>

                    <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">

                        <a asp-controller="Account" asp-action="Login" class="btn btn-light">Sign in</a>

                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Create account</a>

                    </div>

                </div>

            </div>
        </nav>
       
    </header>
    <div class="container-fluid p-0">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="site-footer bg-white border-top py-5 mt-auto">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-6">
                    <a class="d-flex align-items-center gap-2 mb-3 text-decoration-none" href="index.html">
                        <i class="bi bi-mortarboard-fill" style="color:var(--accent-color);font-size:1.2rem"></i>
                        <span style="font-weight:700;color:var(--text-primary);font-size:1rem">LMS Platform</span>
                    </a>
                    <p style="font-size:14px;color:var(--text-muted);max-width:280px;line-height:1.6;margin-bottom:1rem;">Empowering learners worldwide with accessible, high-quality education.</p>
                    <div class="d-flex gap-3">
                        <a href="#" class="text-muted text-decoration-none fs-5"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-muted text-decoration-none fs-5"><i class="bi bi-linkedin"></i></a>
                        <a href="#" class="text-muted text-decoration-none fs-5"><i class="bi bi-youtube"></i></a>
                        <a href="#" class="text-muted text-decoration-none fs-5"><i class="bi bi-github"></i></a>
                    </div>
                </div>
                <div class="col-lg-4 ms-lg-auto">
                    <div class="footer-heading fw-bold mb-3" style="color:var(--text-primary);">Stay Updated</div>
                    <div class="input-group">
                        <input type="email" class="form-control" placeholder="Your email">
                        <button class="btn btn-primary" type="button">Join</button>
                    </div>
                </div>
            </div>
            <div class="pt-3" style="border-top: 1px solid var(--border-color);">
                <p class="mb-0 text-center" style="font-size:13px;color:var(--text-muted)">&copy; 2026 LMS Platform. All rights reserved.</p>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
