@{
    
    if (User.Identity.IsAuthenticated && (User.IsInRole("Instructor") || User.IsInRole("Assistant")))
    {
        Layout = "_DashboardLayout";
    }
    else
    {
        Layout = "_Layout";
    }

    ViewData["Title"] = "Page Not Found";
}

<div class="error-body">
    <div class="text-center animate-fade-in px-3">
        <div class="error-code mb-3" style="font-size: 8rem;">404</div>
        <h1 class="h1 fw-bold mb-3" style="color:var(--text-primary)">Page not found</h1>
        <p class="text-muted mb-5 mx-auto" style="max-width:600px;font-size:16px">The page you are looking for might have been removed or is temporarily unavailable.</p>

        <div class="d-flex gap-2 justify-content-center">
            <button onclick="history.back()" class="btn btn-light">Go Back</button>

            @if (User.Identity.IsAuthenticated && User.IsInRole("Instructor"))
            {
                <a asp-controller="Instructor" asp-action="Dashboard" class="btn btn-primary">Go to Dashboard</a>
            }
            else if (User.Identity.IsAuthenticated && User.IsInRole("Assistant"))
            {
                <a asp-controller="Assistant" asp-action="Dashboard" class="btn btn-primary">Go to Dashboard</a>
            }
            else
            {
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go to Home</a>
            }
        </div>
    </div>
</div>
