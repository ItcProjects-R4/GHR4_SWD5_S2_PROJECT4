
@model IEnumerable<LMS.Domain.ViewModels.Shared.CourseViewModel>
@{
    ViewData["Title"] = "LMS Platform - Learn Without Limits";
    Layout = "_Layout";
}

<!-- Hero -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 animate-fade-in">
                <h1 class="hero-title">
                    The smarter way<br>to <span class="accent">learn anything.</span>
                </h1>
                <p class="hero-lead">
                    Start, switch, or advance your career with expert-led courses, professional certificates, and a community of learners.
                </p>
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="Course" asp-action="Browse" class="btn btn-primary btn-lg px-5">Browse Courses</a>
                </div>
            </div>
            <div class="col-lg-6 animate-fade-in" style="animation-delay:0.15s">
                <div class="hero-image-wrap">
                    <img src="https://res.cloudinary.com/dx1jq63vm/image/upload/v1782624280/hero_bg_wbyx0m.jpg" alt="Student learning online" class="img-fluid w-100">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Courses -->
<section class="section-padding">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4 section-header">
            <div>
                <div class="section-label">Featured</div>
                <h2 class="section-title mb-1">Featured Courses</h2>
                <p class="text-muted mb-0" style="font-size:14px">Our most enrolled courses this month.</p>
            </div>
            <a asp-controller="Course" asp-action="Browse" class="btn btn-light btn-sm d-none d-md-inline-flex align-items-center gap-1">
                View All <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                @foreach (var course in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card course-card h-100">
                            <img src="@(string.IsNullOrEmpty(course.ThumbnailUrl) ? "~/images/course_web_dev.png" : course.ThumbnailUrl)" class="course-card-img" alt="@course.Title">
                            <div class="course-card-body">
                                <h3 class="course-title">@course.Title</h3>
                                <div class="course-meta">
                                    <span><i class="bi bi-book"></i> @course.TotalLessonCount Lessons</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="course-price">@(course.Price == 0 ? "Free" : $"${course.Price:F2}")</span>
                                    <a asp-controller="Course" asp-action="Detail" asp-route-id="@course.Id" class="btn btn-outline-primary btn-sm">View Course</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<!-- How It Works -->
@if (User.Identity?.IsAuthenticated != true)
{
    <!-- How It Works -->
    <section class="section-padding" style="background: var(--bg-color); border-top: 1px solid var(--border-color);">
        <div class="container">
            <div class="text-center section-header">
                <div class="section-label">Simple Process</div>
                <h2 class="section-title">How It Works</h2>
                <p class="text-muted mb-0" style="font-size:14px">Start learning in three easy steps.</p>
            </div>
            <div class="row g-4 text-center">
                <div class="col-md-4">
                    <div class="step-icon"><i class="bi bi-person-plus"></i></div>
                    <h5 class="fw-semibold mb-2" style="color:var(--text-primary)">1. Create Account</h5>
                    <p class="text-muted mb-0" style="font-size:14px">Sign up free and set up your personalized profile in minutes.</p>
                </div>
                <div class="col-md-4">
                    <div class="step-icon"><i class="bi bi-journal-check"></i></div>
                    <h5 class="fw-semibold mb-2" style="color:var(--text-primary)">2. Enroll in a Course</h5>
                    <p class="text-muted mb-0" style="font-size:14px">Browse hundreds of courses and enroll with a single click.</p>
                </div>
                <div class="col-md-4">
                    <div class="step-icon"><i class="bi bi-trophy"></i></div>
                    <h5 class="fw-semibold mb-2" style="color:var(--text-primary)">3. Grow in your career path</h5>
                    <p class="text-muted mb-0" style="font-size:14px">Grow your career with new skills and knowledge.</p>
                </div>
            </div>
        </div>
    </section>
}


<!-- CTA -->
@if (User.Identity?.IsAuthenticated != true)
{
   
    <section class="cta-section">
        <div class="container text-center">
            <h2 class="cta-title">Ready to start learning?</h2>
            <p class="text-muted mb-4" style="font-size:15px">Join thousands of students building their careers today.</p>
            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg px-5">Create account</a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-light btn-lg px-5">Sign in</a>
            </div>
        </div>
    </section>
}
