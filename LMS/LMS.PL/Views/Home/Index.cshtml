
@{
    ViewData["Title"] = "LMS Platform - Learn Without Limits";
    Layout = "_Layout";
    
}

<!-- Hero -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">

            <div class="col-lg-6 animate-fade-in">
                <h1 class="hero-title">
                    The smarter way<br>to <span class="accent">learn anything.</span>
                </h1>

                <p class="hero-lead">
                    Start, switch, or advance your career with expert-led courses, professional certificates, and a community of learners.
                </p>

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="Course" asp-action="Index" class="btn btn-primary btn-lg px-5">
                        Browse Courses
                    </a>
                </div>
            </div>

            <div class="col-lg-6 animate-fade-in" style="animation-delay:0.15s">
                <div class="hero-image-wrap">
                    <img src="~/assets/images/hero_bg.png" class="img-fluid w-100" alt="Student learning online">
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Featured Courses -->
<section class="section-padding">
    <div class="container">

        <div class="d-flex justify-content-between align-items-end mb-4 section-header">
            <div>
                <div class="section-label">Featured</div>
                <h2 class="section-title mb-1">Featured Courses</h2>
                <p class="text-muted mb-0" style="font-size:14px">
                    Our most enrolled courses this month.
                </p>
            </div>

            <a asp-controller="Course" asp-action="Index"
               class="btn btn-light btn-sm d-none d-md-inline-flex align-items-center gap-1">
                View All <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="row g-4">

            <!-- Course 1 -->
            <div class="col-md-6 col-lg-4">
                <div class="card course-card h-100">
                    <img src="~/assets/images/course_web_dev.png" class="course-card-img" alt="Web Development">

                    <div class="course-card-body">
                        <span class="course-category">Development</span>

                        <h3 class="course-title">Full-Stack Web Development Bootcamp 2026</h3>

                        <div class="course-meta">
                            <span><i class="bi bi-clock"></i> 48 hrs</span>
                            <span><i class="bi bi-bar-chart"></i> Beginner</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="course-price">$89.99</span>

                            <a asp-controller="Course" asp-action="Details"
                               class="btn btn-outline-primary btn-sm">
                                View Course
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Course 2 -->
            <div class="col-md-6 col-lg-4">
                <div class="card course-card h-100">
                    <img src="~/assets/images/course_ui_ux.png" class="course-card-img" alt="UI/UX Design">

                    <div class="course-card-body">
                        <span class="course-category">Design</span>

                        <h3 class="course-title">UI/UX Design Masterclass: From Zero to Hero</h3>

                        <div class="course-meta">
                            <span><i class="bi bi-clock"></i> 32 hrs</span>
                            <span><i class="bi bi-bar-chart"></i> Intermediate</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="course-price">$74.99</span>

                            <a asp-controller="Course" asp-action="Details"
                               class="btn btn-outline-primary btn-sm">
                                View Course
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Course 3 -->
            <div class="col-md-6 col-lg-4">
                <div class="card course-card h-100">
                    <img src="~/assets/images/course_data_science.png" class="course-card-img" alt="Data Science">

                    <div class="course-card-body">
                        <span class="course-category">Data Science</span>

                        <h3 class="course-title">Data Science & Machine Learning with Python</h3>

                        <div class="course-meta">
                            <span><i class="bi bi-clock"></i> 60 hrs</span>
                            <span><i class="bi bi-bar-chart"></i> Advanced</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="course-price">$99.99</span>

                            <a asp-controller="Course" asp-action="Details"
                               class="btn btn-outline-primary btn-sm">
                                View Course
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- How It Works -->
<section class="section-padding">
    <div class="container text-center">

        <div class="section-label">Simple Process</div>
        <h2 class="section-title">How It Works</h2>

        <div class="row g-4 mt-3">

            <div class="col-md-4">
                <i class="bi bi-person-plus fs-1"></i>
                <h5>1. Create Account</h5>
                <p>Sign up and set up profile.</p>
            </div>

            <div class="col-md-4">
                <i class="bi bi-journal-check fs-1"></i>
                <h5>2. Enroll in Course</h5>
                <p>Choose and start learning.</p>
            </div>

            <div class="col-md-4">
                <i class="bi bi-trophy fs-1"></i>
                <h5>3. Grow Career</h5>
                <p>Gain skills and certificates.</p>
            </div>

        </div>

    </div>
</section>

<!-- CTA -->
<section class="cta-section text-center">
    <div class="container">

        <h2 class="cta-title">Ready to start learning?</h2>

        <p>Join thousands of students.</p>

        <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg">
            Create account
        </a>

    </div>
</section>