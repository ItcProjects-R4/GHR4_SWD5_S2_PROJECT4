@{
    ViewData["Title"] = "About Us";
    Layout = "_Layout";
}

<!-- Instructor Hero -->
<section class="instructor-hero">
    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <div class="d-flex flex-column flex-md-row gap-4 align-items-md-center animate-fade-in">

                    <div class="instructor-avatar-lg">AK</div>

                    <div>
                        <h1 class="h1 fw-bold mb-1 text-white">Alex King</h1>

                        <p class="h5 mb-3 opacity-75 fw-medium">
                            Senior Software Engineer & Lead Instructor
                        </p>

                        <div class="d-flex flex-wrap gap-4 mt-2">

                            <div class="instructor-stats-badge">
                                <i class="bi bi-people-fill text-success"></i>
                                18,000+ Students
                            </div>

                            <div class="instructor-stats-badge">
                                <i class="bi bi-collection-play-fill text-accent"></i>
                                5 Courses
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-lg-4 mt-4 mt-lg-0 text-lg-end animate-fade-in">

                <div class="d-flex gap-2 justify-content-lg-end flex-wrap">

                    <a href="#" class="btn btn-outline-light rounded-pill px-3">
                        <i class="bi bi-linkedin"></i>
                    </a>

                    <a href="#" class="btn btn-outline-light rounded-pill px-3">
                        <i class="bi bi-facebook"></i>
                    </a>

                    <a href="#" class="btn btn-outline-light rounded-pill px-3">
                        <i class="bi bi-github"></i>
                    </a>

                    <a href="#" class="btn btn-outline-light rounded-pill px-3">
                        <i class="bi bi-youtube"></i>
                    </a>

                </div>

            </div>

        </div>

        <div class="row mt-5 pt-3 animate-fade-in">

            <div class="col-lg-8">

                <h2 class="h4 fw-bold mb-4 text-white">Biography</h2>

                <p class="opacity-75 lead" style="line-height:1.9;">
                    With over a decade of experience in full-stack development and software architecture,
                    Alex King has dedicated his career to building scalable systems and mentoring developers.
                    His focus is on practical engineering and real-world software solutions.
                </p>

            </div>

        </div>

    </div>
</section>
