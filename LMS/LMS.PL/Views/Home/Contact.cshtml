@{
    ViewData["Title"] = "Contact Us";
    Layout = "_Layout";
}

<!-- Contact Section -->
<main class="section-padding bg-light-gray">
    <div class="container">

        <div class="row justify-content-center">
            <div class="col-lg-8 text-center mb-5 animate-fade-in">

                <h1 class="display-5 fw-bold mb-3">
                    Get in <span class="text-gradient">Touch</span>
                </h1>

                <p class="lead text-secondary">
                    Have questions or feedback? We'd love to hear from you. Fill out the form below and our team will get back to you shortly.
                </p>

            </div>
        </div>

        <div class="row g-5">

            <!-- Contact Info -->
            <div class="col-lg-5 animate-fade-in" style="animation-delay: 0.1s;">

                <div class="card h-100 p-4 border-0 shadow-sm">

                    <div class="card-body">

                        <h3 class="fw-bold mb-4">Contact Information</h3>

                        <div class="d-flex align-items-start mb-4">

                            <div class="text-primary rounded-circle p-3 me-3 d-flex align-items-center justify-content-center"
                                 style="width: 50px; height: 50px; background-color: var(--secondary-light);">

                                <i class="bi bi-envelope-fill fs-4"></i>

                            </div>

                            <div>
                                <h5 class="fw-bold mb-1 text-primary">Email Us</h5>
                                <p class="text-secondary mb-0">
                                    support@lmsplatform.com<br>
                                    info@lmsplatform.com
                                </p>
                            </div>

                        </div>

                        <div class="d-flex align-items-start">

                            <div class="text-primary rounded-circle p-3 me-3 d-flex align-items-center justify-content-center"
                                 style="width: 50px; height: 50px; background-color: var(--secondary-light);">

                                <i class="bi bi-telephone-fill fs-4"></i>

                            </div>

                            <div>
                                <h5 class="fw-bold mb-1 text-primary">Call Us</h5>
                                <p class="text-secondary mb-0">
                                    +1 (555) 123-4567<br>
                                    Mon-Fri, 9am-5pm PST
                                </p>
                            </div>

                        </div>

                        <hr class="my-4">

                        <h5 class="fw-bold mb-3 text-primary">Follow Us</h5>

                        <div class="d-flex gap-2">

                            <a href="#" class="btn btn-outline-primary rounded-pill px-3">
                                <i class="bi bi-linkedin"></i>
                            </a>

                            <a href="#" class="btn btn-outline-primary rounded-pill px-3">
                                <i class="bi bi-facebook"></i>
                            </a>

                            <a href="#" class="btn btn-outline-primary rounded-pill px-3">
                                <i class="bi bi-github"></i>
                            </a>

                            <a href="#" class="btn btn-outline-primary rounded-pill px-3">
                                <i class="bi bi-youtube"></i>
                            </a>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Contact Form -->
            <div class="col-lg-7 animate-fade-in" style="animation-delay: 0.2s;">

                <div class="card p-4 p-md-5 border-0 shadow-sm">

                    <form id="contactForm"
                          onsubmit="event.preventDefault(); alert('Message sent successfully!');">

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label for="firstName" class="form-label">First Name</label>
                                <input type="text" class="form-control" id="firstName" placeholder="John" required>
                                <div class="invalid-feedback">First name is required.</div>
                            </div>

                            <div class="col-md-6">
                                <label for="lastName" class="form-label">Last Name</label>
                                <input type="text" class="form-control" id="lastName" placeholder="Doe" required>
                                <div class="invalid-feedback">Last name is required.</div>
                            </div>

                            <div class="col-12">
                                <label for="email" class="form-label">Email Address</label>
                                <input type="email" class="form-control" id="email" placeholder="john@example.com" required>
                                <div class="invalid-feedback">A valid email is required.</div>
                            </div>

                            <div class="col-12">
                                <label for="subject" class="form-label">Subject</label>
                                <select class="form-select" id="subject" required>
                                    <option value="" selected disabled>Select a subject</option>
                                    <option value="general">General Inquiry</option>
                                    <option value="support">Technical Support</option>
                                    <option value="billing">Billing Question</option>
                                    <option value="feedback">Feedback</option>
                                </select>
                                <div class="invalid-feedback">Please select a subject.</div>
                            </div>

                            <div class="col-12">
                                <label for="message" class="form-label">Message</label>
                                <textarea class="form-control" id="message" rows="5"
                                          placeholder="How can we help you?" required></textarea>
                                <div class="invalid-feedback">Message cannot be empty.</div>
                            </div>

                            <div class="col-12 mt-4">
                                <button type="submit" class="btn btn-primary btn-lg w-100">
                                    Send Message
                                </button>
                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>
</main>