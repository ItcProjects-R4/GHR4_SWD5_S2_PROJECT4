
@model LMS.Domain.ViewModels.ContactFormViewModel
@{
    Layout = "_Layout";
}

<main class="section-padding bg-light-gray">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center mb-5 animate-fade-in">
                <h1 class="display-5 fw-bold mb-3">Get in <span class="text-gradient">Touch</span></h1>
                <p class="lead text-secondary">Have questions or feedback? Fill out the form below and our team will get back to you.</p>
            </div>
        </div>

        <div class="row g-5">
            <div class="col-lg-5 animate-fade-in" style="animation-delay: 0.1s;">
                <div class="card h-100 p-4 border-0 shadow-sm">
                    <div class="card-body">
                        <h3 class="fw-bold mb-4">Contact Information</h3>
                        <div class="d-flex align-items-start mb-4">
                            <div class="text-primary rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; background-color: var(--secondary-light);">
                                <i class="bi bi-envelope-fill fs-4"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1 text-primary">Email Us</h5>
                                <p class="text-secondary mb-0">support@lmsplatform.com</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-start">
                            <div class="text-primary rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; background-color: var(--secondary-light);">
                                <i class="bi bi-telephone-fill fs-4"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1 text-primary">Call Us</h5>
                                <p class="text-secondary mb-0">+1 (555) 123-4567</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-7 animate-fade-in" style="animation-delay: 0.2s;">
                <div class="card p-4 p-md-5 border-0 shadow-sm">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success border-0 shadow-sm mb-4" style="border-radius: 12px;">
                            <i class="bi bi-check-circle-fill me-2 fs-5"></i> @TempData["SuccessMessage"]
                        </div>
                    }

                    <form asp-controller="Home" asp-action="Contact" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label small fw-bold">First Name</label>
                                <input asp-for="FirstName" class="form-control" placeholder="John">
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label small fw-bold">Last Name</label>
                                <input asp-for="LastName" class="form-control" placeholder="Doe">
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Email" class="form-label small fw-bold">Email Address</label>
                                <input asp-for="Email" class="form-control" placeholder="john@example.com">
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Subject" class="form-label small fw-bold">Subject</label>
                                <select asp-for="Subject" class="form-select">
                                    <option value="" selected disabled>Select a subject</option>
                                    <option value="General">General Inquiry</option>
                                    <option value="Support">Technical Support</option>
                                    <option value="Billing">Billing Question</option>
                                    <option value="Feedback">Feedback</option>
                                </select>
                                <span asp-validation-for="Subject" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Message" class="form-label small fw-bold">Message</label>
                                <textarea asp-for="Message" class="form-control" rows="5" placeholder="How can we help you?"></textarea>
                                <span asp-validation-for="Message" class="text-danger small"></span>
                            </div>
                            <div class="col-12 mt-4">
                                <button type="submit" class="btn btn-primary btn-lg w-100">Send Message</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>