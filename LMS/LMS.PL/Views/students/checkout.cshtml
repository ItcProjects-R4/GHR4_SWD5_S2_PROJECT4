@model LMS.Domain.Models.Course

@{
    ViewData["Title"] = "Checkout";
}

<div class="container section-padding mt-5">
    <div class="text-center mb-5">
        <h1 class="h2 fw-bold">Checkout</h1>
        <p class="text-secondary">Review your order and complete enrollment.</p>
    </div>

    <div class="row g-5">
        <div class="col-lg-8 animate-fade-in">
            <div class="card p-4 p-md-5">
                <h3 class="h5 fw-bold mb-4">Enrollment Action</h3>
                
                <form asp-controller="Checkout" asp-action="Pay" method="post">
                    
                    <input type="hidden" name="courseId" value="@Model.Id" />

                    @if (Model.Price == 0)
                    {
                        <div class="alert alert-success mb-4 border-0 bg-success bg-opacity-10">
                            <i class="bi bi-gift-fill text-success me-2"></i>
                            <span class="text-success fw-bold">Great news! This course is completely free.</span>
                        </div>
                        <p class="text-muted small mb-4">Click below to instantly add this course to your library. No payment required.</p>
                        <button type="submit" class="btn btn-success btn-lg w-100">
                            Enroll for Free Now
                        </button>
                    }
                    else
                    {
                        <div class="alert alert-info mb-4 border-0 bg-primary bg-opacity-10">
                            <i class="bi bi-shield-lock-fill text-primary me-2"></i>
                            <span class="text-primary fw-bold">Secure Payment via Paymob</span>
                        </div>
                        <p class="text-muted small mb-4">You will be redirected to Paymob's secure gateway to enter your card details safely. We do not store your payment information.</p>
                        
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <img src="https://paymob.com/images/logo.svg" alt="Paymob" style="height: 30px;">
                            <i class="bi bi-credit-card fs-3 text-secondary"></i>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            Proceed to Secure Payment (@Model.Price EGP)
                        </button>
                    }
                </form>
            </div>
        </div>

        <div class="col-lg-4 animate-fade-in" style="animation-delay: 0.1s;">
            <div class="card p-4 shadow-sm">
                <h3 class="h5 fw-bold mb-4">Order Summary</h3>
                <div class="d-flex gap-3 mb-4">
                    <div class="bg-secondary bg-opacity-25 rounded d-flex align-items-center justify-content-center" style="width: 80px; height: 60px;">
                        <i class="bi bi-camera-video text-secondary fs-4"></i>
                    </div>
                    <div>
                        <h4 class="h6 fw-bold mb-1">@Model.Title</h4>
                        <p class="small text-muted mb-0">Stitch Academy</p>
                    </div>
                </div>
                <hr>
                <div class="d-flex justify-content-between mb-2">
                    <span>Course Price</span>
                    <span>@Model.Price EGP</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Discount</span>
                    <span class="text-success">-0.00 EGP</span>
                </div>
                <hr>
                <div class="d-flex justify-content-between mb-0 h5 fw-bold">
                    <span>Total</span>
                    <span>@Model.Price EGP</span>
                </div>
            </div>
            
            <div class="mt-4 text-center">
                <a asp-controller="Course" asp-action="Details" asp-route-id="@Model.Id" class="text-secondary small text-decoration-none">
                    <i class="bi bi-arrow-left"></i> Back to Course Details
                </a>
            </div>
        </div>
    </div>
</div>