                                    <div class="mini-course-card">
                                        <img src="../assets/images/course_design.png" class="mini-course-thumb" alt="Course">
                                        <div class="mini-course-info">
                                            <h5>UI/UX Design Masterclass 2026</h5>
                                            <div class="mb-2">
                                                <span class="rating-pill"><i class="bi bi-star-fill"></i> 4.9 (1.8k)</span>
                                                <span class="ms-2 small text-muted">by Sophia Williams</span>
                                            </div>
                                            <div class="fw-bold text-primary">$69.99</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Right: Receipt Summary -->
                                <div class="receipt-summary-pane">
                                    <h6 class="fw-bold mb-3 small text-uppercase text-muted">Receipt Summary</h6>
                                    
