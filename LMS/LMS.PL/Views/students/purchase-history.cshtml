            @model IEnumerable<LMS.Domain.Models.Payment>

            @{
                ViewData["Title"] = "Purchase History";
            }

            <div class="mb-4 animate-fade-in">
                <h2 class="h2 fw-bold mb-0" style="color:var(--text-primary)">Purchase History</h2>
            </div>

            <div class="accordion transaction-accordion animate-fade-in" id="purchaseAccordion">
    
                @if (!Model.Any())
                {
                    <div class="alert alert-info border-0 bg-primary bg-opacity-10 text-primary fw-bold">
                        <i class="bi bi-info-circle-fill me-2"></i> You have not made any purchases yet.
                    </div>
                }
                else
                {
                    @foreach (var payment in Model)
                    {
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#trans-@payment.Id">
                                    <span class="transaction-date">@payment.PaidAt.ToString("dd MMMM, yyyy 'at' hh:mm tt")</span>
                                    <div class="transaction-summary-meta d-none d-md-flex">
                                        <div class="summary-meta-item">
                                            <i class="bi bi-play-circle"></i> 1 Course
                                        </div>
                                        <div class="summary-meta-item">
                                            <i class="bi bi-currency-dollar"></i> @payment.Amount EGP
                                        </div>
                                        <div class="summary-meta-item">
                                            @if (payment.Status == LMS.Domain.Enums.PaymentStatus.Completed)
                                            {
                                                <span class="badge bg-success text-white"><i class="bi bi-check-circle me-1"></i> Paid</span>
                                            }
                                            else if (payment.Status == LMS.Domain.Enums.PaymentStatus.Pending)
                                            {
                                                <span class="badge bg-warning text-dark"><i class="bi bi-clock-history me-1"></i> Pending</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger text-white"><i class="bi bi-x-circle me-1"></i> Failed</span>
                                            }
                                        </div>
                                    </div>
                                </button>
                            </h2>
                
                            <div id="trans-@payment.Id" class="accordion-collapse collapse" data-bs-parent="#purchaseAccordion">
                                <div class="accordion-body p-0">
                                    <div class="transaction-details-grid flex-column flex-lg-row">
                            
                                        <div class="product-details-pane">
                                            <h6 class="fw-bold mb-3 small text-uppercase text-muted">Purchased Item</h6>
                                
                                            <div class="mini-course-card">
                                                <div class="bg-secondary bg-opacity-25 rounded d-flex align-items-center justify-content-center me-3" style="width: 80px; height: 60px;">
                                                    <i class="bi bi-camera-video text-secondary fs-4"></i>
                                                </div>
                                                <div class="mini-course-info">
                                                    <h5>@payment.Course.Title</h5>
                                                    <div class="fw-bold text-primary mt-1">@payment.Amount EGP</div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="receipt-summary-pane">
                                            <h6 class="fw-bold mb-3 small text-uppercase text-muted">Receipt Summary</h6>
                                
                                            <div class="receipt-meta-row">
                                                <i class="bi bi-calendar3"></i>
                                                <span>@payment.PaidAt.ToString("dd MMMM, yyyy 'at' hh:mm tt")</span>
                                            </div>
                                            <div class="receipt-meta-row">
                                                <i class="bi bi-cash-stack"></i>
                                                <span class="fw-bold text-primary">Total Amount: @payment.Amount EGP</span>
                                            </div>

                                            <div class="card-info-box mt-3">
                                                <div class="small text-muted mb-1">Transaction Reference</div>
                                                <div class="fw-bold small mb-2 text-uppercase">
                                                    @(string.IsNullOrEmpty(payment.TransactionId) ? "Awaiting Confirmation" : payment.TransactionId)
                                                </div>
                                    
                                                <div class="small text-muted mb-1">Payment Status</div>
                                                <div class="fw-bold small">@payment.Status.ToString()</div>
                                            </div>

                                            @if (payment.Status == LMS.Domain.Enums.PaymentStatus.Completed)
                                            {
                                                <div class="mt-4 d-grid">
                                                    <button class="btn btn-light btn-sm" onclick="window.print()"><i class="bi bi-printer me-2"></i>Print Receipt</button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

                <!-- Transaction 2 -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#trans2">
                            <span class="transaction-date">15th July, 2021 at 09:15 AM</span>
                            <div class="transaction-summary-meta d-none d-md-flex">
                                <div class="summary-meta-item">
                                    <i class="bi bi-play-circle"></i> 1 Course
                                </div>
                                <div class="summary-meta-item">
                                    <i class="bi bi-currency-dollar"></i> $79.99
                                </div>
                                <div class="summary-meta-item">
                                    <i class="bi bi-credit-card"></i> Mastercard **** 8890
                                </div>
                            </div>
                        </button>
                    </h2>
                    <div id="trans2" class="accordion-collapse collapse" data-bs-parent="#purchaseAccordion">
                        <div class="accordion-body p-0">
                            <div class="transaction-details-grid flex-column flex-lg-row">
                                <div class="product-details-pane">
                                    <div class="mini-course-card">
                                        <img src="../assets/images/course_python.png" class="mini-course-thumb" alt="Course">
                                        <div class="mini-course-info">
                                            <h5>Python for Data Analysis & Visualization</h5>
                                            <div class="mb-2">
                                                <span class="rating-pill"><i class="bi bi-star-fill"></i> 4.7 (3.1k)</span>
                                                <span class="ms-2 small text-muted">by Dr. Amir Patel</span>
                                            </div>
                                            <div class="fw-bold text-primary">$79.99</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="receipt-summary-pane">
                                    <h6 class="fw-bold mb-3 small text-uppercase text-muted">Receipt Summary</h6>
                                    <div class="receipt-meta-row"><i class="bi bi-calendar3"></i><span>15th July, 2021 at 09:15 AM</span></div>
                                    <div class="receipt-meta-row"><i class="bi bi-play-circle"></i><span>Total Courses: 1</span></div>
                                    <div class="receipt-meta-row"><i class="bi bi-cash-stack"></i><span class="fw-bold text-primary">Total Amount: $79.99</span></div>
                                    
                                    <div class="card-info-box">
                                        <div class="small text-muted mb-1">Cardholder Name</div>
                                        <div class="fw-bold small mb-2 text-uppercase">Maya Chen</div>
                                        <div class="small text-muted mb-1">Card Number</div>
                                        <div class="fw-bold small mb-2">5412 **** **** 8890</div>
                                        <div class="small text-muted mb-1">Expiry Date</div>
                                        <div class="fw-bold small">11 / 26</div>
                                    </div>
                                    <div class="mt-4 d-grid">
                                        <button class="btn btn-light btn-sm"><i class="bi bi-download me-2"></i>Download Receipt</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Pagination -->
            <div class="d-flex justify-content-between align-items-center mt-4 animate-fade-in">
                <span class="text-muted small">Showing 2 of 7 transactions</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0 gap-1">
                        <li class="page-item disabled"><a class="page-link rounded" href="#">Previous</a></li>
                        <li class="page-item active"><a class="page-link rounded" href="#">1</a></li>
                        <li class="page-item"><a class="page-link rounded" href="#">2</a></li>
                        <li class="page-item"><a class="page-link rounded" href="#">Next</a></li>
                    </ul>
                </nav>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="../assets/js/main.js"></script>
</body>
</html>