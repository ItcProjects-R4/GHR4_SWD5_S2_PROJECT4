                            <div class="transaction-details-grid flex-column flex-lg-row">
                                <!-- Left: Product Details -->
                                <div class="product-details-pane">
                                    <h6 class="fw-bold mb-3 small text-uppercase text-muted">Purchased Items</h6>
                                    
                                    <div class="mini-course-card">
                                        <img src="../assets/images/course_web_dev.png" class="mini-course-thumb" alt="Course">
                                        <div class="mini-course-info">
