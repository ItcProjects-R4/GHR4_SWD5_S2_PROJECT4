<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Purchase History - LMS Platform</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="../assets/css/index.css">
</head>
<body>

    <div class="dashboard-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <ul class="sidebar-menu">
                <li class="menu-item">
                    <a href="dashboard.html" class="menu-link">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>
                <li class="menu-item">
                    <a href="courses.html" class="menu-link">
                        <i class="bi bi-book"></i> Courses
                    </a>
                </li>
                <li class="menu-item">
                    <a href="purchase-history.html" class="menu-link active">
                        <i class="bi bi-credit-card"></i> Purchase History
                    </a>
                </li>
                <li class="menu-item">
                    <a href="settings.html" class="menu-link">
                        <i class="bi bi-gear"></i> Settings
                    </a>
                </li>
                <li class="menu-item mt-auto border-top pt-2">
                    <a href="../login.html" class="menu-link text-danger">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </a>
                </li>
            </ul>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <div class="mb-4 animate-fade-in">
                <h2 class="h2 fw-bold mb-0" style="color:var(--text-primary)">Purchase History</h2>
            </div>

            @* <!-- Transaction List (Accordion Style) -->
