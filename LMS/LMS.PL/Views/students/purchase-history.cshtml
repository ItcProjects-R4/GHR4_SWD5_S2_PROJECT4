                                        <i class="bi bi-calendar3"></i>
                                        <span>31st August, 2021 at 11:30 PM</span>
                                    </div>
                                    <div class="receipt-meta-row">
                                        <i class="bi bi-play-circle"></i>
                                        <span>Total Courses: 2</span>
                                    </div>
                                    <div class="receipt-meta-row">
                                        <i class="bi bi-cash-stack"></i>
                                        <span class="fw-bold text-primary">Total Amount: $159.98</span>
                                    </div>
                                    <div class="receipt-meta-row">
                                        <i class="bi bi-credit-card"></i>
                                        <span>Payment Method: Visa</span>
                                    </div>

                                    <div class="card-info-box">
                                        <div class="small text-muted mb-1">Cardholder Name</div>
                                        <div class="fw-bold small mb-2 text-uppercase">Maya Chen</div>
                                        <div class="small text-muted mb-1">Card Number</div>
                                        <div class="fw-bold small mb-2">4142 **** **** 4242</div>
