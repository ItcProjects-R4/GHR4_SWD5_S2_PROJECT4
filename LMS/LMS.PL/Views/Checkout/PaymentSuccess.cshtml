@{
    ViewData["Title"] = "Payment Success - LMS Platform";

    
    var courseId = ViewBag.CourseId ?? 0;
    var courseTitle = ViewBag.CourseTitle ?? "your new course";
}

<div class="container d-flex align-items-center justify-content-center min-vh-100">
    <div class="text-center animate-fade-in" style="max-width: 500px;">
        <div style="width:72px;height:72px;border-radius:50%;background:#edfbf5;display:flex;align-items:center;justify-content:center;margin:0 auto 1.5rem">
            <i class="bi bi-check-lg" style="color:#1a6e4a;font-size:2rem"></i>
        </div>
        <h1 class="h3 fw-bold mb-2" style="color:var(--text-primary)">Payment Successful</h1>

        <p class="text-muted mb-4" style="font-size:15px">
            You've been successfully enrolled in <strong>@courseTitle</strong>.
        </p>

        <div class="d-grid gap-3">
            @if (courseId > 0)
            {
               
                <a asp-controller="Student" asp-action="WatchCourse" asp-route-id="@courseId" class="btn btn-primary btn-lg">
                    Start Learning Now
                </a>
            }
            else
            {

                <a asp-controller="Student" asp-action="Courses" class="btn btn-primary btn-lg">
                    Start Learning Now
                </a>
            }

           
            <a asp-controller="Student" asp-action="Dashboard" class="btn btn-outline-secondary btn-lg">
                Go to Dashboard
            </a>
        </div>
    </div>
</div>
