@model InstructorCourseDetailsPageViewModel
@{
    ViewData["Title"] = Model.Course.Title;
    Layout = "_DashboardLayout";
}

<div class="w-100">
<div class="container py-4">
    <div class="premium-hero mb-4">
    <div class="hero-glow"></div>
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0" style="--bs-breadcrumb-divider-color: rgba(255,255,255,0.4); font-size: 0.85rem;">
            <li class="breadcrumb-item">
                <a asp-action="Dashboard" asp-controller="Instructor" class="text-white-50 text-decoration-none">
                    <i class="bi bi-house-fill me-1"></i>Dashboard
                </a>
            </li>
            <li class="breadcrumb-item">
                <a asp-action="Enrollments" asp-controller="Instructor" class="text-white-50 text-decoration-none">Enrollments</a>
            </li>
            <li class="breadcrumb-item text-white active" aria-current="page">@Model.Course.Title</li>
        </ol>
    </nav>
    <div class="row align-items-stretch g-4">
        <div class="col-lg-7 d-flex flex-column justify-content-between">
            <div>
                <span class="badge bg-primary px-3 py-1.5 rounded-pill mb-3 text-uppercase fw-semibold" style="letter-spacing:0.05em; font-size:0.75rem; width: fit-content; display: inline-block;">
                </span>
                <h1 class="hero-title mb-3">@Model.Course.Title</h1>
                <p class="hero-desc text-white-50 mb-4" style="max-width:620px;">@Model.Course.Description</p>
            </div>

            <div class="hero-stats d-flex flex-wrap gap-4 mt-auto">
                <div class="hero-stat">
                    <div class="hero-stat-value">@Model.TotalContents</div>
                    <div class="hero-stat-label">Total Contents</div>
                </div>
                <div class="hero-stat">
                    <div class="hero-stat-value">@Model.TotalModules</div>
                    <div class="hero-stat-label">Modules</div>
                </div>
                <div class="hero-stat">
                    <div class="hero-stat-value text-info">@Model.EnrolledStudentsCount</div>
                    <div class="hero-stat-label">Enrolled Students</div>
                </div>
                <div class="hero-stat">
                    <div class="hero-stat-value text-success">@Model.CompletedStudentsCount</div>
                    <div class="hero-stat-label">Completed Students</div>
                </div>
            </div>
        </div>

        <div class="col-lg-5 d-flex flex-column justify-content-between align-self-stretch">
            <div class="d-flex justify-content-lg-end justify-content-start align-items-center gap-3 mb-4 mb-lg-0 mt-lg-2">
                
                <div class="price-badge-premium px-4 py-2 rounded-4 d-flex flex-column align-items-end">
                    <span class="text-white-50 text-uppercase fw-semibold" style="font-size: 0.65rem; letter-spacing: 0.05em;">Course Price</span>
                    <span class="fw-bold text-white fs-3 lh-1">@(Model.Course.Price == 0 ? "Free" : $"${Model.Course.Price:N2}")</span>
                </div>
                
                <a asp-action="EditCourse" asp-controller="Instructor" asp-route-id="@Model.Course.CourseId" class="btn btn-premium-edit rounded-4 px-4 py-2.5 fw-bold d-inline-flex align-items-center gap-2">
                    <i class="bi bi-pencil-square"></i> Edit Course
                </a>
            </div>

            <div class="progress-panel mt-auto">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-semibold text-white-50" style="font-size:0.9rem;">Average Student Progress</span>
                    <span class="fw-bold fs-5 text-white">@Model.AverageProgressPercent%</span>
                </div>
                <div class="progress" style="height:10px; border-radius:99px; background:rgba(255,255,255,0.15);">
                    <div class="progress-bar bg-info"
                         role="progressbar"
                         style="width:@Model.AverageProgressPercent%; border-radius:99px;"
                         aria-valuenow="@Model.AverageProgressPercent" aria-valuemin="0" aria-valuemax="100">
                    </div>
                </div>
                <p class="text-white-50 mt-2 mb-0" style="font-size:0.8rem;">
                    Tracking overall student performance for this course
                </p>
            </div>
        </div>
    </div>
</div>

    <div class="row g-4">
        <div class="col-lg-4 col-md-5">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden curriculum-sidebar-card">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-collection-play-fill text-primary me-2"></i>Course Curriculum
                    </h5>
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2.5 py-1" style="font-size:0.75rem;">
                        @Model.TotalContents Contents
                    </span>
                </div>
                <div class="card-body p-0 scrollable-curriculum" style="max-height: 720px; overflow-y: auto;">
                    @if (!Model.Course.Modules.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-journal-x display-6 text-muted d-block mb-3"></i>
                            <h6 class="fw-semibold text-muted">No modules available yet</h6>
                        </div>
                    }
                    else
                    {
                        <div class="accordion accordion-flush curriculum-accordion" id="curriculumAccordion">
                            @foreach (var module in Model.Course.Modules)
                            {
                                int totalLessonsInModule = module.Contents.Count;
                                bool isModuleHasActiveContent = module.Contents.Any(c => c.Id == Model.ActiveContentId);
                                string collapseId = $"module-{module.Id}";

                                <div class="accordion-item border-bottom">
                                    <h2 class="accordion-header" id="heading-@module.Id">
                                        <button class="accordion-button fw-bold text-dark px-3 py-3"
                                                type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@collapseId"
                                                aria-expanded="@(isModuleHasActiveContent ? "true" : "false")"
                                                aria-controls="@collapseId"
                                                style="font-size:0.9rem; background: #fafafa;">
                                            <div class="d-flex align-items-center gap-2.5 w-100 me-2">
                                                <div class="flex-grow-1 text-truncate">
                                                    <span class="d-block text-truncate">@module.Title</span>
                                                    <span class="text-muted d-block fw-normal" style="font-size:0.75rem; margin-top: 2px;">
                                                        @totalLessonsInModule Content@(totalLessonsInModule != 1 ? "s" : "")@(module.Assignment != null ? " · 1 Assignment" : "")
                                                    </span>
                                                </div>
                                            </div>
                                        </button>
                                    </h2>

                                    <div id="@collapseId"
                                         class="accordion-collapse collapse @(isModuleHasActiveContent ? "show" : "")"
                                         aria-labelledby="heading-@module.Id"
                                         data-bs-parent="#curriculumAccordion">
                                        <div class="accordion-body p-2 bg-white">
                                            @if (!module.Contents.Any())
                                            {
                                                <div class="text-muted text-center py-3" style="font-size:0.8rem;">
                                                    <i class="bi bi-inbox me-2"></i>No content added yet.
                                                </div>
                                            }
                                            else
                                            {
                                                @foreach (var content in module.Contents)
                                                {
                                                    bool isActive = content.Id == Model.ActiveContentId;
                                                    <a asp-action="ContentDetails"
                                                       asp-controller="Instructor"
                                                       asp-route-id="@content.Id"
                                                       class="content-item-link lesson-nav-item load-content-link @(isActive ? "active-lesson" : "")"
                                                       data-content-id="@content.Id"
                                                       title="@content.Title">
                                                        <div class="content-icon-wrap" id="icon-container-@content.Id">
                                                            <i class="bi bi-play-circle completion-icon" style="font-size:1.1rem; color:#3b82f6;"></i>
                                                        </div>
                                                        <span class="content-label flex-grow-1 text-truncate">@content.Title</span>
                                                    </a>
                                                }
                                            }

                                            @if (module.Assignment != null)
                                            {
                                                <a asp-action="AssignmentDetails" asp-controller="Instructor" asp-route-id="@module.Assignment.Id" data-assignment-id="@module.Assignment.Id" class="load-assignment-link d-block mt-1 p-2 rounded-3 border-dashed text-decoration-none" 
                                                   style="background:#fffbeb; border:1px dashed #fde68a; transition: all 0.2s; cursor: pointer;">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="assignment-icon-wrap">
                                                            <i class="bi bi-clipboard2-check-fill" style="color:#f59e0b; font-size:1rem;"></i>
                                                        </div>
                                                        <div class="flex-grow-1 text-truncate">
                                                            <div class="fw-semibold text-truncate text-dark" style="font-size:0.8rem;">@module.Assignment.Title</div>
                                                            <div class="text-muted" style="font-size:0.7rem;">
                                                                Due: @module.Assignment.DueDate.ToString("MMM dd") · @module.Assignment.MaxScore pts
                                                            </div>
                                                        </div>
                                                        <div>
                                                            <span class="badge bg-warning text-dark px-2 py-0.5" style="font-size:0.6rem;">Submissions</span>
                                                        </div>
                                                    </div>
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8 col-md-7">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden content-viewer-card" style="min-height: 580px; background: #fff;">
                <div id="lessonContentContainer" class="card-body p-4 position-relative">
                    @if (Model.ActiveContent != null)
                    {
                        <partial name="_Content" model="Model.ActiveContent" />
                    }
                    else
                    {
                        <div class="text-center py-5 my-5" id="contentPlaceholder">
                            <div id="placeholderText">
                                <i class="bi bi-mortarboard display-1 text-primary-gradient mb-3 d-block opacity-50"></i>
                                <h4 class="fw-bold text-dark">Select content or assignment to preview</h4>
                                <p class="text-muted" style="max-width: 400px; margin: 0 auto;">Choose any content from the curriculum sidebar on the left to review content or grade student submissions.</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
</div>
</div>

@section Scripts {
    <script>
        $(document).on('click', '.load-content-link', function (e) {
            e.preventDefault();

            const $link = $(this);
            const url = $link.attr('href');

            $('.load-content-link').removeClass('active-lesson');
            $('.load-assignment-link').removeClass('active-assignment');
            $link.addClass('active-lesson');

            $('#lessonContentContainer').html(
                '<div class="text-center py-5 my-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>'
            );

            $.ajax({
                url: url,
                type: 'GET',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function (html) {
                    $('#lessonContentContainer').html(html);
                },
                error: function () {
                    $('#lessonContentContainer').html(
                        '<div class="text-center py-5 text-danger"><i class="bi bi-exclamation-triangle display-6 d-block mb-3"></i><p class="fw-semibold mb-0">Could not load this content. Please try again.</p></div>'
                    );
                }
            });
        });

        $(document).on('click', '.load-assignment-link', function (e) {
            e.preventDefault();

            const $link = $(this);
            const url = $link.attr('href');

            $('.load-content-link').removeClass('active-lesson');
            $('.load-assignment-link').removeClass('active-assignment');
            $link.addClass('active-assignment');

            $('#lessonContentContainer').html(
                '<div class="text-center py-5 my-5"><div class="spinner-border text-warning" role="status"><span class="visually-hidden">Loading...</span></div></div>'
            );

            $.ajax({
                url: url,
                type: 'GET',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function (html) {
                    $('#lessonContentContainer').html(html);
                },
                error: function () {
                    $('#lessonContentContainer').html(
                        '<div class="text-center py-5 text-danger"><i class="bi bi-exclamation-triangle display-6 d-block mb-3"></i><p class="fw-semibold mb-0">Could not load this assignment. Please try again.</p></div>'
                    );
                }
            });
        });

        $(document).on('click', '#nextLessonBtn', function (e) {
            e.preventDefault();
            const $current = $('.active-lesson, .active-assignment').first();
            if ($current.length) {
                const $allLinks = $('.load-content-link, .load-assignment-link');
                const currentIndex = $allLinks.index($current);
                if (currentIndex >= 0 && currentIndex < $allLinks.length - 1) {
                    const $next = $allLinks.eq(currentIndex + 1);
                    const $accordionCollapse = $next.closest('.accordion-collapse');
                    if ($accordionCollapse.length && !$accordionCollapse.hasClass('show')) {
                        $accordionCollapse.collapse('show');
                    }
                    $next[0].click();
                } else {
                    $(this).prop('disabled', true).text('End of Course');
                }
            }
        });
    </script>
}