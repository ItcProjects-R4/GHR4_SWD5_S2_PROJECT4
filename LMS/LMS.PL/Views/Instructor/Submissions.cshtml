@model LMS.Domain.ViewModels.Instructor.CourseDetails.SubmissionsPageViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = Model.PageTitle;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold mb-0" style="color:var(--text-primary)">Student Submissions</h1>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px; background-color: #d1e7dd; color: #0f5132;">
        <i class="bi bi-check-circle-fill me-2 fs-5"></i> @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form asp-action="Submissions" method="get">
            <div class="row g-3 align-items-center justify-content-between">
                <div class="col-md-4">
                    <h5 class="fw-bold mb-0 text-dark" style="font-size: 1.1rem;">
                        Submissions Queue <span class="badge bg-primary text-white rounded-pill ms-2" style="font-size: 0.72rem; padding: 0.35em 0.8em;">@Model.Submissions?.Count()</span>
                    </h5>
                </div>
                <div class="col-md-8 d-flex flex-wrap align-items-center justify-content-md-end gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-secondary small fw-bold text-nowrap" style="font-size: 0.8rem;"><i class="bi bi-funnel-fill me-1"></i>Filter By:</span>
                        <select name="statusFilter" onchange="this.form.submit()" class="form-select bg-light border-0 px-3 py-2 fw-semibold text-secondary" style="font-size: 0.85rem; min-width: 160px; height: 38px; border-radius: 20px;">
                            <option value="all" selected="@(Model.StatusFilter == "all")">All Submissions</option>
                            <option value="pending" selected="@(Model.StatusFilter == "pending")">Pending Review</option>
                            <option value="graded" selected="@(Model.StatusFilter == "graded")">Graded Only</option>
                        </select>
                    </div>
                    <div style="min-width: 250px;">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0" style="border-top-left-radius: 20px; border-bottom-left-radius: 20px; height: 38px;">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" name="searchString" value="@Model.SearchString" class="form-control bg-light border-0 text-secondary" placeholder="Search student or course..." style="border-top-right-radius: 20px; border-bottom-right-radius: 20px; font-size: 0.85rem; height: 38px;">
                            <button type="submit" class="btn btn-primary d-none">Search</button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="row g-3">
    @if (Model.Submissions != null && Model.Submissions.Any())
    {
        @foreach (var sub in Model.Submissions)
        {
            var isGraded = sub.Status == LMS.Domain.Enums.SubmissionStatus.Graded;
            <div class="col-12">
                <div class="card border-0 shadow-sm transition-base hover-shadow-md">
                    <div class="card-body p-4">
                        <div class="row align-items-center g-3">
                            <div class="col-md-4">
                                <div class="d-flex align-items-center">
                                    <div class="user-avatar-sm me-3" style="width: 44px; height: 44px; font-weight: 700; font-size: 1rem; border-radius: 50%; display: flex; align-items: center; justify-content: center; background-color: var(--accent-color); color: #fff;">
                                        @(string.IsNullOrEmpty(sub.Student.FirstName) ? "S" : sub.Student.FirstName.Substring(0, 1).ToUpper() + sub.Student.LastName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold">@sub.Student.FirstName @sub.Student.LastName</h6>
                                        <div class="text-muted small"><i class="bi bi-clock me-1"></i>Submitted @sub.SubmittedAt.ToString("MMM dd, yyyy HH:mm")</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-5">
                                <div class="fw-bold small">@sub.Assignment.Module.Course.Title</div>
                                <div class="text-muted" style="font-size: 0.78rem;">@sub.Assignment.Title</div>
                            </div>
                            <div class="col-md-3 text-md-end">
                                <div class="d-flex align-items-center justify-content-md-end gap-3">
                                    @if (!isGraded)
                                    {
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2 fw-semibold">Pending</span>
                                        <a asp-action="Grade" asp-route-id="@sub.Id" class="btn btn-primary btn-sm px-4 py-2 rounded-3 fw-bold">Grade</a>
                                    }
                                    else
                                    {
                                        <div class="me-2 text-md-end">
                                            <div class="fw-bold text-success h5 mb-0">@sub.Grade/@sub.Assignment.MaxScore</div>
                                            <span class="text-muted small" style="font-size: 10px;">Graded Score</span>
                                        </div>
                                        <button type="button" class="btn btn-outline-secondary btn-sm px-3 py-2 rounded-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#feedbackDetailModal-@sub.Id">View Feedback</button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (isGraded)
            {
                <!-- Feedback Modal for this specific submission -->
                <div class="modal fade" id="feedbackDetailModal-@sub.Id" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow">
                            <div class="modal-header border-0 pb-0">
                                <h5 class="modal-title fw-bold">Grade & Feedback Details</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body p-4">
                                <div class="d-flex align-items-center mb-4 border-bottom pb-3">
                                    <div class="user-avatar-sm me-3 bg-secondary text-white" style="width: 44px; height: 44px; font-weight: 700; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                        @(string.IsNullOrEmpty(sub.Student.FirstName) ? "S" : sub.Student.FirstName.Substring(0, 1).ToUpper() + sub.Student.LastName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0">@sub.Student.FirstName @sub.Student.LastName</h6>
                                        <p class="text-muted small mb-0">@sub.Assignment.Module.Course.Title</p>
                                    </div>
                                </div>
                                <div class="p-3 bg-light rounded-3 mb-4 text-center">
                                    <div class="text-muted small mb-1">Final Score</div>
                                    <div class="h2 fw-bold mb-0 text-success">@sub.Grade / @sub.Assignment.MaxScore</div>
                                </div>
                                <h6 class="fw-bold small mb-2 text-dark">Instructor Comments:</h6>
                                <p class="text-secondary small mb-0" style="line-height: 1.6;">@sub.Comment</p>
                            </div>
                            <div class="modal-footer border-0 pt-0">
                                <button type="button" class="btn btn-primary px-4 fw-semibold rounded-3" data-bs-dismiss="modal">Close</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    }
    else
    {
        <div class="col-12 py-5 text-center text-secondary">
            <i class="bi bi-file-earmark-check display-4 mb-3 d-block text-muted"></i>
            <h5>No submissions queue active.</h5>
            <p class="small mb-0">Students' project uploads will appear here for review.</p>
        </div>
    }
</div>