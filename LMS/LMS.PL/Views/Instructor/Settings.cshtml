@model LMS.Domain.ViewModels.Account.ProfileSettingsViewModel
@{
    ViewData["Title"] = "Settings";
    Layout = "_DashboardLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4 animate-fade-in">
    <h1 class="h3 fw-bold mb-0" style="color:var(--text-primary)">Profile Settings</h1>
</div>

<div class="animate-fade-in">
    <!-- Success/Error Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: var(--radius-base); background-color: #f0fdf4; color: #15803d;">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: var(--radius-base); background-color: #fef2f2; color: #b91c1c;">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Left Column: Avatar Card -->
        <div class="col-lg-3">
            <div class="card p-4 text-center border-0 shadow-sm" style="border-radius: 12px; background-color: white;">
                <div class="position-relative d-inline-block mx-auto mb-3">
                    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" alt="Avatar" class="rounded-circle mx-auto" style="width: 100px; height: 100px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="avatar-lg mx-auto" style="width: 100px; height: 100px; font-weight: 700; font-size: 2.2rem; background-color: var(--accent-color); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                            @(string.IsNullOrEmpty(Model.FirstName) ? "U" : Model.FirstName.Substring(0, Math.Min(2, Model.FirstName.Length)).ToUpper())
                        </div>
                    }
                </div>
                <h3 class="h6 fw-bold mb-1" style="color:var(--text-primary)">@Model.FirstName @Model.LastName</h3>
                <span class="badge badge-role badge-student mb-3">Instructor</span>
                <hr style="border-color:var(--border-color); margin:1.5rem 0">

                <!-- Pure HTML Avatar Upload Form -->
                <form asp-action="UpdateAvatar" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="mb-2 text-start">
                        <label class="form-label small text-muted">Select New Image</label>
                        <input type="file" name="avatarFile" accept="image/*" class="form-control form-control-sm" required />
                    </div>
                    <button type="submit" class="btn btn-light btn-sm w-100">
                        <i class="bi bi-upload me-1"></i> Upload Avatar
                    </button>
                </form>
            </div>
        </div>

        <!-- Right Column: Personal Information & Security Cards -->
        <div class="col-lg-9">
            <!-- 1. Personal Information Card -->
            <div class="card p-4 mb-4 border-0 shadow-sm" style="border-radius: 12px; background-color: white;">
                <h4 class="h6 fw-bold mb-4" style="color:var(--text-primary)">Personal Information</h4>

                <!-- Direct Input Fields (Always Editable) -->
                <form asp-action="UpdateProfile" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">First Name</label>
                            <input type="text" name="FirstName" class="form-control" value="@Model.FirstName" required>
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Last Name</label>
                            <input type="text" name="LastName" class="form-control" value="@Model.LastName" required>
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email Address</label>
                            <input type="email" name="Email" class="form-control" value="@Model.Email" required>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone Number</label>
                            <input type="tel" name="PhoneNumber" class="form-control" value="@Model.PhoneNumber">
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Biography</label>
                            <textarea name="Biography"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Tell students about yourself...">@Model.Biography</textarea>
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary btn-sm px-4">Save Changes</button>
                    </div>
                </form>
            </div>

            
            <div class="card p-4 border-0 shadow-sm" style="border-radius: 12px; background-color: white;">
                <h4 class="h6 fw-bold mb-4" style="color:var(--text-primary)">Change Password</h4>
                <form asp-action="UpdatePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Current Password</label>
                            <input type="password" name="CurrentPassword" class="form-control" placeholder="••••••••" required>
                            <span asp-validation-for="PasswordInfo.CurrentPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">New Password</label>
                            <input type="password" name="NewPassword" class="form-control" placeholder="••••••••" required>
                            <span asp-validation-for="PasswordInfo.NewPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Confirm New Password</label>
                            <input type="password" name="ConfirmPassword" class="form-control" placeholder="••••••••" required>
                            <span asp-validation-for="PasswordInfo.ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary btn-sm px-4">Update Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
