@model IEnumerable<LMS.Domain.Models.ApplicationUser>
@inject Microsoft.AspNetCore.Identity.UserManager<LMS.Domain.Models.ApplicationUser> UserManager
@{
    Layout = "_DashboardLayout";
    var searchString = Context.Request.Query["searchString"].ToString();
    var selectedRole = Context.Request.Query["roleFilter"].ToString();
    if (string.IsNullOrEmpty(selectedRole))
    {
        selectedRole = "All Roles";
    }
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius:12px;">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius:12px;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Main Content -->
<div class="d-flex justify-content-between align-items-center mb-4 animate-fade-in">
    <h1 class="h3 fw-bold mb-0" style="color:var(--text-primary)">User Management</h1>
    <button class="btn btn-primary px-4" data-bs-toggle="modal" data-bs-target="#createAssistantModal">
        <i class="bi bi-person-plus me-2"></i> Create Assistant
    </button>
</div>

<div asp-validation-summary="All" class="text-danger small mb-4"></div>

<form asp-controller="Instructor" asp-action="Users" method="get" class="card border-0 shadow-sm p-3 mb-4 animate-fade-in">
    <div class="row g-3 align-items-center">
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="searchString" value="@searchString" class="form-control border-start-0" placeholder="Search by name, email or ID...">
            </div>
        </div>
        <div class="col-md-auto ms-auto">
            <select name="roleFilter" onchange="this.form.submit()" class="form-select border-0 bg-light fw-semibold" style="min-width: 160px;">
                <option value="All Roles" selected="@(selectedRole == "All Roles")">All Roles</option>
                <option value="Student" selected="@(selectedRole == "Student")">Student</option>
                <option value="Assistant" selected="@(selectedRole == "Assistant")">Assistant</option>
            </select>
        </div>
    </div>
</form>

<div class="card border-0 shadow-sm animate-fade-in">
    <div class="table-responsive">
        @if (Model != null && Model.Any())
        {
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4" style="width: 40%">User</th>
                        <th style="width: 20%">Role</th>
                        <th style="width: 20%">Join Date</th>
                        <th class="text-end pe-4" style="width: 20%">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isAssistant = await UserManager.IsInRoleAsync(item, "Assistant");
                        var claims = isAssistant ? await UserManager.GetClaimsAsync(item) : null;
                        var rawPermissions = claims != null ? claims.Where(c => c.Type == "Permission").Select(c => c.Value).ToList() : new List<string>();
                        
                        var mappedPermissions = rawPermissions.Select(p => p switch
                        {
                            "GradeSubmissions" => "Grade Assignments",
                            "ManageContent" => "Manage Content",
                            "ViewReports" => "View Reports",
                            "ManageStudents" => "Manage Students",
                            _ => p
                        }).ToList();

                        var initials = (!string.IsNullOrEmpty(item.FirstName) ? item.FirstName.Substring(0, 1).ToUpper() : "U") +
                                       (!string.IsNullOrEmpty(item.LastName) ? item.LastName.Substring(0, 1).ToUpper() : "");

                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="user-avatar-sm me-3 @(isAssistant ? "bg-warning text-white" : "")">
                                        @initials
                                    </div>
                                    <div>
                                        <div class="fw-bold">@(item.FirstName ?? "Unknown") @(item.LastName ?? "")</div>
                                        <div class="text-muted small">@(item.Email ?? "No Email")</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge badge-role @(isAssistant ? "badge-assistant" : "badge-student")">
                                    @(isAssistant ? "ASSISTANT" : "STUDENT")
                                </span>
                            </td>
                            <td class="small text-muted">
                                @(isAssistant ? "Jun 25, 2026" : "Jun 12, 2026")
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">
                                    @if (isAssistant)
                                    {
                                        <button class="btn btn-light btn-sm px-3"
                                                onclick='viewUserDetails("@(item.FirstName) @(item.LastName)", "ASSISTANT", "@initials", "@item.Email", "AST-@(item.Id?.Substring(0, 8))", @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mappedPermissions)))'
                                                title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        
                                        <button class="btn btn-light btn-sm px-3" data-bs-toggle="modal" data-bs-target="#editPermissionsModal-@item.Id" title="Edit Permissions">
                                            <i class="bi bi-shield-lock" style="color: var(--accent-color);"></i>
                                        </button>
                                        
                                        <form asp-controller="Instructor" asp-action="DeleteUser" method="post" onsubmit="return confirm('Are you sure you want to delete this assistant?');" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@item.Id" />
                                            <button type="submit" class="btn btn-light btn-sm px-3 text-danger" title="Delete User">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-people text-muted display-4 mb-3"></i>
                <h5 class="fw-bold text-secondary">No records found</h5>
                <p class="text-muted small">Try refining your search keyword or selected role.</p>
            </div>
        }
    </div>
</div>

<!-- User Details Modal -->
<div class="modal fade" id="userDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">User Information</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-4">
                    <div class="col-md-4 text-center border-end">
                        <div id="modal-user-avatar" class="user-avatar-lg bg-primary text-white mx-auto mb-3 d-flex align-items-center justify-content-center fw-bold fs-1 rounded-circle shadow-sm" style="width: 100px; height: 100px;"></div>
                        <h4 id="modal-user-name" class="h6 fw-bold mb-1"></h4>
                        <p id="modal-user-email" class="text-muted small mb-2"></p>
                        <span id="modal-user-role" class="badge badge-role mb-3"></span>
                    </div>
                    <div class="col-md-8">
                        <div id="assistant-info" class="d-none">
                            <div class="mb-4">
                                <label class="text-muted small d-block mb-1">Employee ID</label>
                                <span id="modal-assistant-id" class="fw-bold text-primary"></span>
                            </div>
                            <div>
                                <label class="text-muted small d-block mb-2">Permissions</label>
                                <div id="modal-assistant-permissions" class="d-flex flex-wrap gap-2"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Assistant Modal -->
<div class="modal fade" id="createAssistantModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Create Assistant</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-controller="Instructor" asp-action="CreateAssistant" method="post">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">First Name</label>
                            <input type="text" name="FirstName" class="form-control" placeholder="e.g. John" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Last Name</label>
                            <input type="text" name="LastName" class="form-control" placeholder="e.g. Doe" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Email Address</label>
                        <input type="email" name="Email" class="form-control" placeholder="e.g. john@example.com" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Password</label>
                        <div class="input-group">
                            <input type="password" name="Password" class="form-control border-end-0" placeholder="Create a strong password" required>
                            <button class="btn btn-light border border-start-0" type="button" onclick="togglePasswordVisibility(this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold">Role Permissions</label>
                        <div class="row">
                            <div class="col-6">
                                <div class="form-check small mb-2">
                                    <input class="form-check-input" type="checkbox" name="SelectedPermissions" value="GradeSubmissions" id="p1">
                                    <label class="form-check-label" for="p1">Grade Assignments</label>
                                </div>
                                <div class="form-check small mb-2">
                                    <input class="form-check-input" type="checkbox" name="SelectedPermissions" value="ManageContent" id="p2">
                                    <label class="form-check-label" for="p2">Manage Content</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-check small mb-2">
                                    <input class="form-check-input" type="checkbox" name="SelectedPermissions" value="ViewReports" id="p3">
                                    <label class="form-check-label" for="p3">View Reports</label>
                                </div>
                                <div class="form-check small mb-2">
                                    <input class="form-check-input" type="checkbox" name="SelectedPermissions" value="ManageStudents" id="p4">
                                    <label class="form-check-label" for="p4">Manage Students</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="text-end pt-2">
                        <button type="submit" class="btn btn-primary py-2 px-5 fw-bold">Create Assistant Account</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Permissions Modals  -->
@if (Model != null)
{
    @foreach (var item in Model)
    {
        var isAssistant = await UserManager.IsInRoleAsync(item, "Assistant");
        if (isAssistant)
        {
            var claims = await UserManager.GetClaimsAsync(item);
            var permissions = claims.Where(c => c.Type == "Permission").Select(c => c.Value).ToList();
            var initials = (!string.IsNullOrEmpty(item.FirstName) ? item.FirstName.Substring(0, 1).ToUpper() : "U") +
                           (!string.IsNullOrEmpty(item.LastName) ? item.LastName.Substring(0, 1).ToUpper() : "");

            <div class="modal fade" id="editPermissionsModal-@item.Id" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow">
                        <div class="modal-header border-0 pb-0">
                            <h5 class="modal-title fw-bold">Edit Permissions</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body p-4">
                            <div class="d-flex align-items-center mb-4 p-3 bg-light rounded-3">
                                <div class="user-avatar-sm me-3 bg-warning text-white">@initials</div>
                                <div>
                                    <div class="fw-bold">@(item.FirstName ?? "Unknown") @(item.LastName ?? "")</div>
                                    <div class="text-muted small">ASSISTANT • AST-@(item.Id?.Substring(0, 8) ?? "00000000")</div>
                                </div>
                            </div>
                            <form asp-controller="Instructor" asp-action="UpdatePermissions" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@item.Id" />
                                <div class="mb-4">
                                    <label class="form-label small fw-bold mb-3">Update Access Rights</label>
                                    <div class="row g-3">
                                        <div class="col-6">
                                            <div class="form-check small mb-3">
                                                <input class="form-check-input" type="checkbox" name="selectedPermissions" value="GradeSubmissions" id="ep1-@item.Id" @(permissions.Contains("GradeSubmissions") ? "checked" : "")>
                                                <label class="form-check-label" for="ep1-@item.Id">Grade Assignments</label>
                                            </div>
                                            <div class="form-check small mb-3">
                                                <input class="form-check-input" type="checkbox" name="selectedPermissions" value="ManageContent" id="ep2-@item.Id" @(permissions.Contains("ManageContent") ? "checked" : "")>
                                                <label class="form-check-label" for="ep2-@item.Id">Manage Content</label>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="form-check small mb-3">
                                                <input class="form-check-input" type="checkbox" name="selectedPermissions" value="ViewReports" id="ep3-@item.Id" @(permissions.Contains("ViewReports") ? "checked" : "")>
                                                <label class="form-check-label" for="ep3-@item.Id">View Reports</label>
                                            </div>
                                            <div class="form-check small mb-3">
                                                <input class="form-check-input" type="checkbox" name="selectedPermissions" value="ManageStudents" id="ep4-@item.Id" @(permissions.Contains("ManageStudents") ? "checked" : "")>
                                                <label class="form-check-label" for="ep4-@item.Id">Manage Students</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-primary fw-bold py-2">Save Permissions</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
}



@section Scripts {
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
    <script>
        function viewUserDetails(name, role, initials, email, assistantId, permissions) {
            document.getElementById('modal-user-name').textContent = name;
            document.getElementById('modal-user-email').textContent = email;
            document.getElementById('modal-user-avatar').textContent = initials;
            
            var roleBadge = document.getElementById('modal-user-role');
            roleBadge.textContent = role;
            roleBadge.className = 'badge badge-role badge-' + role.toLowerCase();
            
            var assistantInfo = document.getElementById('assistant-info');
            assistantInfo.classList.toggle('d-none', role.toUpperCase() !== 'ASSISTANT');
            
            if (role.toUpperCase() === 'ASSISTANT') {
                document.getElementById('modal-assistant-id').textContent = assistantId;
                
                var permContainer = document.getElementById('modal-assistant-permissions');
                permContainer.innerHTML = '';
                
                for (var i = 0; i < permissions.length; i++) {
                    permContainer.innerHTML +=
                        '<span class="badge bg-light text-dark border fw-medium px-3 py-2">' +
                        '<i class="bi bi-shield-check text-success me-1"></i> ' + permissions[i] +
                        '</span>';
                }
            }
            
            var modal = new bootstrap.Modal(document.getElementById('userDetailsModal'));
            modal.show();
        }
    </script>
}