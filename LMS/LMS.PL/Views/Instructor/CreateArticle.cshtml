@model LMS.Domain.ViewModels.Instructor.CourseDetails.CreateArticleViewModel
@{
    Layout = null; // Blank layout to accommodate full screen rich editor toolbar as per mockup
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.PageTitle</title>
    <link href="<https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Nunito:wght@700;800&display=swap>" rel="stylesheet">
    <link href="<https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css>" rel="stylesheet">
    <link rel="stylesheet" href="<https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css>">
    <link rel="stylesheet" href="~/css/index.css">
</head>
<body class="bg-light">

    <!-- Form Container -->
    <form asp-action="CreateArticle" method="post" id="articleForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ModuleId" />
        <input type="hidden" asp-for="CourseId" />
        <input type="hidden" asp-for="Text" id="articleBodyInput" />

        <!-- Header navbar matching mockup -->
        <nav class="navbar navbar-expand-lg navbar-public sticky-top bg-white border-bottom shadow-sm" style="z-index: 1040;">
            <div class="container-fluid px-4">
                <div class="d-flex align-items-center">
                    <a class="navbar-brand d-flex align-items-center gap-2" href="#">
                        <i class="bi bi-mortarboard-fill" style="color: var(--accent-color); font-size: 1.2rem;"></i>
                        <span style="font-weight:700; font-size:1rem; color:var(--text-primary); letter-spacing:-0.01em;">LMS Platform</span>
                    </a>
                </div>
                <div class="ms-auto d-flex align-items-center gap-3">
                    <button type="button" class="btn btn-light text-secondary fw-semibold border-0 bg-transparent" disabled>Drafting Article</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-pill fw-bold shadow-sm">Save &amp; Exit</button>
                </div>
            </div>
        </nav>

        <div class="dashboard-container d-flex flex-column py-4 px-5">
            <div class="mb-4">
                <a href="@Url.Action("CreateCourse", new { id = Model.CourseId, step = 2 })" class="btn btn-light btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Curriculum
                </a>
            </div>

            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Courses")">Courses</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("CreateCourse", new { id = Model.CourseId, step = 2 })">Create Course</a></li>
                    <li class="breadcrumb-item active">New Article</li>
                </ol>
            </nav>

            <div class="row g-4">
                <div class="col-lg-9">
                    <div class="editor-container animate-fade-in border rounded bg-white shadow-sm overflow-hidden">
                        <div class="editor-toolbar d-flex align-items-center bg-light border-bottom p-2 gap-1 flex-wrap">
                            <button type="button" class="btn btn-sm btn-light border" onclick="execCmd('bold')" title="Bold"><i class="bi bi-type-bold"></i></button>
                            <button type="button" class="btn btn-sm btn-light border" onclick="execCmd('italic')" title="Italic"><i class="bi bi-type-italic"></i></button>
                            <button type="button" class="btn btn-sm btn-light border" onclick="execCmd('underline')" title="Underline"><i class="bi bi-type-underline"></i></button>

                            <div style="width: 1px; height: 20px; background: #ccc; margin: 0 4px;"></div>

                            <button type="button" class="btn btn-sm btn-light border" onclick="execCmd('insertUnorderedList')" title="Bullet List"><i class="bi bi-list-ul"></i></button>
                            <button type="button" class="btn btn-sm btn-light border" onclick="execCmd('insertOrderedList')" title="Numbered List"><i class="bi bi-list-ol"></i></button>

                            <div style="width: 1px; height: 20px; background: #ccc; margin: 0 4px;"></div>

                            <button type="button" class="btn btn-sm btn-light border" onclick="execCmd('createLink', prompt('Enter URL:'))" title="Insert Link"><i class="bi bi-link-45deg"></i></button>
                            <button type="button" class="btn btn-sm btn-light border" onclick="execCmd('removeFormat')" title="Clear Formatting"><i class="bi bi-eraser"></i></button>
                        </div>

                        <div class="editor-content p-5">
                            <input type="text" asp-for="Title" class="form-control border-0 fs-3 fw-bold mb-3 shadow-none px-0" placeholder="Enter Article Title..." required autofocus style="border-bottom: 2px solid #f0f0f0 !important; border-radius: 0;">
                            <div id="editor" contenteditable="true" class="form-control border-0 px-0 shadow-none" placeholder="Start writing your amazing article content here..." style="min-height: 400px; outline: none; font-size: 1.05rem; line-height: 1.7;"></div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h6 class="fw-bold mb-3">Article Settings</h6>
                            <div class="mb-0">
                                <label class="form-label small fw-bold text-muted">Estimated Reading Time</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" class="form-control" value="5" min="1" max="120">
                                    <span class="input-group-text">mins</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <script src="<https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js>"></script>
    <script>
        function execCmd(command, arg = null) {
        document.execCommand(command, false, arg);
        }

        // Intercept form submit to copy contenteditable div text to hidden input field
        document.getElementById('articleForm').addEventListener('submit', function (e) {
        const editorContent = document.getElementById('editor').innerHTML;
        document.getElementById('articleBodyInput').value = editorContent;
        });
    </script>
</body>
</html>