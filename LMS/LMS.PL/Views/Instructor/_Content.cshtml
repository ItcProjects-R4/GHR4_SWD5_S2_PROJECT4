@model ContentViewModel

<div class="lesson-body-wrapper">
    <div class="video-wrapper mb-4" id="videoSection" style="border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px -10px rgba(0,0,0,0.1); border: 1px solid rgba(0,0,0,0.05);">
        <div class="video-container" style="position: relative; padding-bottom: 56.25%; height: 0; background: #0b0f19;">
            <video controls
                   playsinline
                   preload="metadata"
                   data-lesson-id="@Model.Id"
                   style="position:absolute;top:0;left:0;width:100%;height:100%;">
                <source src="@Model.VideoUrl" type="video/mp4" />
                Your browser does not support the video tag.
            </video>
        </div>
    </div>

    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1 text-dark" style="font-size: 1.5rem; letter-spacing: -0.025em; font-family: var(--font-heading);">@Model.Title</h2>
            <span class="text-secondary small fw-medium">
                Module @Model.ModuleOrderIndex: @Model.ModuleTitle • Published @DateTime.Now.ToString("MMMM dd, yyyy")
            </span>
        </div>
        <div>
            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2" style="font-size: 0.8rem; background: #e0e7ff; color: #4338ca !important; border: 1px solid #c7d2fe;">
                <i class="bi bi-eye-fill me-1"></i>Instructor Preview Mode
            </span>
        </div>
    </div>

    <ul class="nav watch-tabs border-bottom mb-4" id="contentTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" 
                    id="description-tab" 
                    data-bs-toggle="tab" 
                    data-bs-target="#description-tab-pane" 
                    type="button" 
                    role="tab" 
                    aria-controls="description-tab-pane" 
                    aria-selected="true">
                Description
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" 
                    id="attach-tab" 
                    data-bs-toggle="tab" 
                    data-bs-target="#attach-tab-pane" 
                    type="button" 
                    role="tab" 
                    aria-controls="attach-tab-pane" 
                    aria-selected="false">
                Attach File
            </button>
        </li>
    </ul>

    <div class="tab-content" id="contentTabsContent">
        <div class="tab-pane fade show active" id="description-tab-pane" role="tabpanel" aria-labelledby="description-tab" tabindex="0">
            <div class="content-description-text mb-4 text-dark" style="font-size: 0.95rem; line-height: 1.7; color: #334155;">
                @if (!string.IsNullOrEmpty(Model.Text))
                {
                    @Html.Raw(Model.Text)
                }
                else
                {
                    <p class="text-muted">No description available for this lecture.</p>
                }
            </div>

            <div class="action-bar-pane d-flex align-items-center justify-content-between pt-4 border-top mt-5 flex-wrap gap-3">
                <button type="button" id="prevLessonBtn" class="btn btn-outline-secondary fw-semibold d-inline-flex align-items-center gap-2 px-4 py-2">
                    <i class="bi bi-chevron-left"></i> Previous Lecture
                </button>

                <div class="text-muted" style="font-size: 0.85rem; font-weight: 500;">
                    Reviewing content as instructor
                </div>

                <button type="button" id="nextLessonBtn" class="btn btn-primary fw-semibold d-inline-flex align-items-center gap-2 px-4 py-2">
                    Next Lecture <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>

        <div class="tab-pane fade" id="attach-tab-pane" role="tabpanel" aria-labelledby="attach-tab" tabindex="0">
            @if (!string.IsNullOrEmpty(Model.ArticleUrl))
            {
                <div class="d-flex align-items-center justify-content-between p-3 mb-3 border rounded-3 bg-white shadow-sm" style="border-radius: 10px;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center justify-content-center bg-light text-primary rounded-3" style="width: 48px; height: 48px; border: 1px solid #e2e8f0;">
                            @if (Model.ArticleUrl.Contains(".pdf", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="bi bi-file-earmark-pdf fs-4 text-danger"></i>
                            }
                            else
                            {
                                <i class="bi bi-file-earmark-zip fs-4 text-info"></i>
                            }
                        </div>
                        <div>
                            <div class="fw-semibold text-dark" style="font-size: 0.95rem;">@System.IO.Path.GetFileName(Model.ArticleUrl)</div>
                            <div class="text-muted small">File Attachment</div>
                        </div>
                    </div>
                    <a href="@Model.ArticleUrl" target="_blank" class="btn btn-light border px-4 py-2 fw-semibold" style="border-radius: 8px;"><i class="bi bi-download me-2"></i>Download</a>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-folder2-open display-6 d-block mb-3 opacity-50"></i>
                    <p class="mb-0">No files attached to this lecture.</p>
                </div>
            }
        </div>
    </div>
</div>