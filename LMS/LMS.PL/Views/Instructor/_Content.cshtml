@model ContentViewModel

<div class="watch-lesson-header d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
    <div class="d-flex align-items-center gap-3">
        <div class="lesson-icon-badge bg-primary-subtle text-primary rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background: #e0e7ff;">
            <i class="bi bi-play-circle-fill fs-4" style="color: #4338ca;"></i>
        </div>
        <div>
            <h3 class="fw-bold mb-1 text-dark" style="font-size: 1.25rem;">@Model.Title</h3>
        </div>
    </div>
    <div>
        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2" style="font-size: 0.8rem; background: #e0e7ff; color: #4338ca !important; border: 1px solid #c7d2fe;">
            <i class="bi bi-eye-fill me-1"></i>Instructor Preview Mode
        </span>
    </div>
</div>

<div class="lesson-body-wrapper">
    <div class="video-wrapper mb-4" id="videoSection">
        <div class="video-container">
            <video controls
                   playsinline
                   preload="metadata"
                   data-lesson-id="@Model.Id"
                   style="position:absolute;top:0;left:0;width:100%;height:100%;">
                <source src="@Model.VideoUrl" type="video/mp4" />
                Your browser does not support the video tag.
            </video>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ArticleUrl))
    {
        @if (Model.ArticleUrl.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
        {
            <div class="pdf-viewer-card mb-4 rounded-4 overflow-hidden shadow-sm" style="border: 1px solid #e2e8f0;">
                <div class="pdf-viewer-header bg-dark text-white px-3 py-2.5 d-flex align-items-center justify-content-between">
                    <span class="fw-semibold" style="font-size:0.875rem;">
                        <i class="bi bi-file-earmark-pdf-fill text-danger me-2 fs-5"></i>@System.IO.Path.GetFileName(Url.Content(Model.ArticleUrl))
                    </span>
                    <a href="@Model.ArticleUrl" target="_blank" class="btn btn-sm btn-outline-light rounded-pill px-3">
                        <i class="bi bi-download me-1"></i>Download PDF
                    </a>
                </div>
                <div class="pdf-container" style="height: 550px; background: #525659;">
                    <iframe src="@Url.Content(Model.ArticleUrl)" style="border: none; width: 100%; height: 100%;"></iframe>
                </div>
            </div>
        }
        else
        {
            <div class="article-link-card mb-4 p-3 rounded-4" style="background: #f8f6ff; border: 1px solid #e9d5ff;">
                <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
                    <div class="d-flex align-items-center gap-3">
                        <div class="article-icon-wrap bg-white rounded-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; border: 1px solid #e9d5ff;">
                            <i class="bi bi-link-45deg fs-4" style="color:#7c3aed;"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark" style="font-size:0.9rem;">Reference Article</div>
                            <a href="@Model.ArticleUrl" target="_blank" rel="noopener noreferrer" class="text-primary text-decoration-none article-url-text" style="font-size: 0.8rem; word-break: break-all;">
                                @Model.ArticleUrl
                            </a>
                        </div>
                    </div>
                    <a href="@Model.ArticleUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                        <i class="bi bi-box-arrow-up-right me-1"></i>Open Article
                    </a>
                </div>
            </div>
        }
    }

    @if (!string.IsNullOrEmpty(Model.Text))
    {
        <div class="content-text-card mb-4 rounded-4 overflow-hidden border shadow-sm" style="background:#fff;">
            <div class="content-text-header px-4 py-3 bg-light border-bottom d-flex align-items-center gap-2">
                <i class="bi bi-journal-text text-primary fs-5"></i>
                <span class="fw-bold text-dark">Lesson Notes</span>
            </div>
            <div class="content-text-body p-4 lesson-html-content" style="font-size: 0.925rem; line-height: 1.75; color: #374151;">
                @Html.Raw(Model.Text)
            </div>
        </div>
    }

    <div class="action-bar-pane d-flex align-items-center justify-content-between p-3 bg-light border rounded-4 mb-2 shadow-sm">
        <div>
            <button type="button" id="nextLessonBtn" class="btn fw-medium d-flex align-items-center gap-1" style="background-color: #4338ca; color: white; border: none; border-radius: 6px; padding: 0.5rem 1.25rem; font-size: 0.95rem; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='#312e81'" onmouseout="this.style.backgroundColor='#4338ca'">
                Next Lesson <i class="bi bi-chevron-right" style="font-size: 0.85rem; padding-top: 2px;"></i>
            </button>
        </div>
        <div class="text-muted" style="font-size: 0.8rem;">
            Reviewing content as instructor
        </div>
    </div>
</div>