@model LMS.Domain.ViewModels.Instructor.CourseDetails.GradeSubmissionViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = Model.PageTitle;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb" style="font-size: 0.85rem;">
        <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none text-muted">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Submissions" class="text-decoration-none text-muted">Submissions</a></li>
        <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Grade @Model.StudentName</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold mb-0" style="color:var(--text-primary)">Grade Workspace</h1>
    <a asp-action="Submissions" class="btn btn-outline-secondary btn-sm px-3 rounded-pill fw-medium">
        <i class="bi bi-arrow-left me-1"></i> Back to Submissions
    </a>
</div>

<div class="row g-4">
    <div class="col-xl-8">
        <!-- Student Details Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 border-bottom pb-3 mb-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="avatar-lg bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 48px; height: 48px; font-size: 1.1rem;">
                            @(string.IsNullOrEmpty(Model.StudentName) ? "S" : Model.StudentName.Substring(0, 1).ToUpper())
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1">@Model.StudentName</h5>
                            <span class="text-secondary small">Student</span>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="small fw-bold text-muted text-uppercase mb-2" style="font-size: 0.7rem; letter-spacing: 0.05em;">Assignment Details</div>
                    <h6 class="fw-bold text-dark mb-1">@Model.AssignmentTitle</h6>
                    <p class="text-secondary small mb-0">@Model.CourseTitle</p>
                </div>

                <div>
                    <div class="small fw-bold text-muted text-uppercase mb-3" style="font-size: 0.7rem; letter-spacing: 0.05em;">Submitted Files</div>
                    @if (!string.IsNullOrEmpty(Model.SubmittedFileUrl))
                    {
                        <div class="p-3 border rounded-3 d-flex align-items-center justify-content-between bg-light flex-wrap gap-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="stat-icon bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center rounded-3" style="width: 48px; height: 48px;">
                                    <i class="bi bi-file-earmark-zip h3 mb-0"></i>
                                </div>
                                <div>
                                    <div class="fw-bold small text-dark">@Model.SubmittedFileName</div>
                                    <div class="text-muted" style="font-size: 0.72rem;">Student Submission File Attachment</div>
                                </div>
                            </div>
                            <a href="@Model.SubmittedFileUrl" class="btn btn-white btn-sm shadow-sm border px-3 rounded-pill fw-semibold" target="_blank" download>
                                <i class="bi bi-download me-1"></i> Download File
                            </a>
                        </div>
                    }
                    else
                    {
                        <p class="text-secondary small mb-0">No files were uploaded with this submission.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <!-- Grading Assessment Panel -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                <h5 class="fw-bold text-dark mb-0">Final Assessment</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Grade" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="SubmissionId" />

                    <div class="mb-4">
                        <label asp-for="Grade" class="form-label small fw-bold text-muted text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.05em;">Score (out of 100)</label>
                        <div class="input-group input-group-lg">
                            <input asp-for="Grade" class="form-control border-2 text-center fw-bold text-primary" required type="number" min="0" max="100" style="border-top-left-radius: 12px; border-bottom-left-radius: 12px;">
                            <span class="input-group-text bg-light border-2 fw-bold text-muted" style="border-top-right-radius: 12px; border-bottom-right-radius: 12px;">/ 100</span>
                        </div>
                        <span asp-validation-for="Grade" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Comment" class="form-label small fw-bold text-muted text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.05em;">Feedback Comments</label>
                        <textarea asp-for="Comment" class="form-control border-2" rows="6" placeholder="Provide grading feedback comments..."></textarea>
                        <span asp-validation-for="Comment" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary py-3 fw-bold rounded-3 shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Submit Grade
                        </button>
                        <a asp-action="Submissions" class="btn btn-light py-2 fw-semibold text-secondary border-0 mt-1">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>