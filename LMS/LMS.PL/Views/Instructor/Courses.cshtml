@model LMS.Domain.ViewModels.Instructor.CourseDetails.CoursesPageViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = Model.PageTitle;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold mb-0" style="color:var(--text-primary)">Course Management</h1>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px;">
        <i class="bi bi-check-circle-fill me-2"></i> @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm p-3 mb-4">
    <form asp-action="Courses" method="get">
        <div class="row g-3 align-items-center">
            <div class="col-md-8">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchString" value="@Model.SearchString" class="form-control border-start-0" placeholder="Search courses...">
                </div>
            </div>
            <div class="col-md-auto ms-auto d-flex gap-2">
                <select name="sortBy" onchange="this.form.submit()" class="form-select border-0 bg-light fw-semibold" style="min-width: 160px;">
                    <option value="newest" selected="@(Model.SortBy == "newest")">Newest First</option>
                    <option value="oldest" selected="@(Model.SortBy == "oldest")">Oldest First</option>
                    <option value="title-asc" selected="@(Model.SortBy == "title-asc")">Alphabetical (A-Z)</option>
                    <option value="title-desc" selected="@(Model.SortBy == "title-desc")">Alphabetical (Z-A)</option>
                    <option value="price-asc" selected="@(Model.SortBy == "price-asc")">Price (Low to High)</option>
                    <option value="price-desc" selected="@(Model.SortBy == "price-desc")">Price (High to Low)</option>
                </select>
                <button type="submit" class="btn btn-primary d-none">Apply</button>
            </div>
        </div>
    </form>
</div>

<!-- Course Grid -->
<div class="row g-4">
    @if (Model.Courses != null && Model.Courses.Any())
    {
        @foreach (var course in Model.Courses)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card course-card border-0 shadow-sm h-100">
                    <img src="@(string.IsNullOrEmpty(course.ThumbnailUrl) ? "<https://placehold.co/600x400?text=No+Thumbnail>" : course.ThumbnailUrl)" class="course-card-img" style="height: 160px; object-fit: cover;" alt="@course.Title">
                    <div class="course-card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="course-title mb-0">@course.Title</h5>
                            <span class="badge bg-primary-subtle text-primary rounded-pill px-2">@(course.Enrollments?.Count ?? 0) students</span>
                        </div>
                        <p class="text-muted small mb-3">Modules: @(course.Modules?.Count ?? 0) · Lessons: @course.TotalLessonCount</p>
                        <div class="d-flex justify-content-between align-items-center mt-auto">
                            <span class="fw-bold text-primary">@(course.Price == 0 ? "Free" : $"{course.Price:N2} EGP")</span>
                            <div class="d-flex gap-2">
                                <a asp-action="CourseDetails" asp-route-id="@course.Id" class="btn btn-light btn-sm shadow-sm" title="View Details"><i class="bi bi-eye"></i></a>
                                <a asp-action="CreateCourse" asp-route-id="@course.Id" asp-route-step="2" class="btn btn-light btn-sm shadow-sm text-primary" title="Edit Curriculum"><i class="bi bi-pencil"></i></a>
                                <button type="button" class="btn btn-outline-danger btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#deleteConfirmModal-@course.Id" title="Delete"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Delete Confirmation Modal -->
            <div class="modal fade" id="deleteConfirmModal-@course.Id" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
                    <div class="modal-content border-0 shadow-lg">
                        <div class="modal-body p-4 text-center">
                            <div class="stat-icon bg-danger bg-opacity-10 text-danger mx-auto mb-4" style="width: 60px; height: 60px; font-size: 1.5rem; display: flex; align-items: center; justify-content: center; border-radius: 50%;">
                                <i class="bi bi-exclamation-triangle"></i>
                            </div>
                            <h5 class="fw-bold mb-2">Delete Course?</h5>
                            <p class="text-muted small mb-4">Are you sure you want to delete "<strong>@course.Title</strong>"? This action cannot be undone and will delete all enrollment contexts.</p>
                            <form asp-action="DeleteCourse" asp-route-id="@course.Id" method="post">
                                @Html.AntiForgeryToken()
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-light flex-grow-1 fw-bold" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-danger flex-grow-1 fw-bold">Delete Now</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 py-5 text-center text-secondary">
            <i class="bi bi-book display-4 mb-3 d-block text-muted"></i>
            <h5>No courses created yet.</h5>
            <p class="small mb-0">Create your first course to start teaching!</p>
        </div>
    }
</div>