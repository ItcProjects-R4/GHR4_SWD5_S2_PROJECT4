@model LMS.Domain.ViewModels.BrowseCoursesViewModel
@{
    Layout = "_Layout";
}

<header style="padding: 3rem 0 2rem; background: var(--surface-color); border-bottom: 1px solid var(--border-color);">
    <div class="container">
        <div style="font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--accent-color);margin-bottom:0.5rem">Catalogue</div>
        <h1 style="font-size:1.75rem;font-weight:700;color:var(--text-primary);letter-spacing:-0.02em;margin-bottom:0.5rem">Browse Courses</h1>
        <p class="text-muted mb-0" style="font-size:14px">Unlock your potential with expert-led professional courses.</p>
    </div>
</header>

<section class="py-3" style="background:var(--surface-color);border-bottom:1px solid var(--border-color);">             
    <div class="container">
        <form asp-controller="Course" asp-action="Browse" method="get">
            <div class="row g-2 align-items-center">
                <div class="col-lg-5">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="searchString" value="@Model.SearchString" class="form-control border-start-0" placeholder="Search courses…">
                    </div>
                </div>
                <div class="col-lg-7 d-flex justify-content-lg-end gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-1">
                        <span class="small text-muted me-2">Type:</span>
                        <select name="typeFilter" onchange="this.form.submit()" class="form-select form-select-sm w-auto">
                            <option value="all" selected="@(Model.TypeFilter == "all")">All Types</option>
                            <option value="free" selected="@(Model.TypeFilter == "free")">Free Only</option>
                            <option value="paid" selected="@(Model.TypeFilter == "paid")">Paid Only</option>
                        </select>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <span class="small text-muted me-2">Sort:</span>
                        <select name="sortOrder" onchange="this.form.submit()" class="form-select form-select-sm w-auto">
                            <option value="newest" selected="@(Model.SortOrder == "newest")">Newest First</option>
                            <option value="title-asc" selected="@(Model.SortOrder == "title-asc")">Name: A to Z</option>
                            <option value="price-asc" selected="@(Model.SortOrder == "price-asc")">Price: Low to High</option>
                            <option value="price-desc" selected="@(Model.SortOrder == "price-desc")">Price: High to Low</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm px-4">Apply</button>
                </div>
            </div>
        </form>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="row g-4">
            @if (Model.Courses != null && Model.Courses.Any())
            {
                @foreach (var course in Model.Courses)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card course-card h-100">
                            <img src="@(string.IsNullOrEmpty(course.ThumbnailUrl) ? "~/images/course_web_dev.png" : course.ThumbnailUrl)" class="course-card-img" alt="@course.Title">
                            <div class="course-card-body">
                                <h3 class="course-title">@course.Title</h3>
                                <div class="course-meta">
                                    <span><i class="bi bi-book"></i> @course.TotalLessonCount Lessons</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="course-price">@(course.Price == 0 ? "Free" : $"${course.Price:F2}")</span>
                                    <a asp-controller="Course" asp-action="Detail" asp-route-id="@course.Id" class="btn btn-outline-primary btn-sm">View Course</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 py-5 text-center">
                    <i class="bi bi-search display-3 mb-3 d-block text-muted"></i>
                    <h4 class="fw-bold">No courses found</h4>
                    <p class="text-secondary small">Try adjusting your filters or search keywords.</p>
                </div>
            }
        </div>
    </div>
</section>